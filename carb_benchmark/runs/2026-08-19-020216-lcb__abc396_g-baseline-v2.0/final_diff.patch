-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    H = int(input_data[0])
+    W = int(input_data[1])
+    rows = input_data[2:2 + H]
+    
+    N = 1 << W
+    cnt = [0] * N
+    for s in rows:
+        cnt[int(s, 2)] += 1
+        
+    popcount = [0] * N
+    for i in range(1, N):
+        popcount[i] = popcount[i >> 1] + (i & 1)
+        
+    g = [min(popcount[i], W - popcount[i]) for i in range(N)]
+    
+    def fwht(a):
+        for bit in range(W):
+            h = 1 << bit
+            step = h << 1
+            if h < 64:
+                for i in range(0, N, step):
+                    for j in range(i, i + h):
+                        u = a[j]
+                        v = a[j + h]
+                        a[j] = u + v
+                        a[j + h] = u - v
+            else:
+                for i in range(0, N, step):
+                    left = a[i : i + h]
+                    right = a[i + h : i + step]
+                    a[i : i + h] = [u + v for u, v in zip(left, right)]
+                    a[i + h : i + step] = [u - v for u, v in zip(left, right)]
+
+    fwht(cnt)
+    fwht(g)
+    res = [cnt[i] * g[i] for i in range(N)]
+    fwht(res)
+    
+    ans = min(res) // N
+    print(ans)
+
+if __name__ == '__main__':
+    main()
