-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    A = input_data[1]
+
+    v = [int(c) for c in A]
+    dp = [1] * len(v)
+
+    for _ in range(N):
+        next_v = []
+        next_dp = []
+        for (v1, dp1), (v2, dp2), (v3, dp3) in zip(
+            zip(v[0::3], dp[0::3]),
+            zip(v[1::3], dp[1::3]),
+            zip(v[2::3], dp[2::3])
+        ):
+            vp = 1 if (v1 + v2 + v3 >= 2) else 0
+            c1 = dp1 if v1 == vp else 0
+            c2 = dp2 if v2 == vp else 0
+            c3 = dp3 if v3 == vp else 0
+            
+            next_v.append(vp)
+            next_dp.append(c1 + c2 + c3 - max(c1, c2, c3))
+            
+        v = next_v
+        dp = next_dp
+
+    print(dp[0])
+
+if __name__ == '__main__':
+    main()
