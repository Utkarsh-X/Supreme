-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+from collections import Counter
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    cards = [int(x) for x in input_data]
+    
+    counts = Counter(cards)
+    possible = False
+    for x in counts:
+        if counts[x] >= 3:
+            for y in counts:
+                if x != y and counts[y] >= 2:
+                    possible = True
+                    break
+        if possible:
+            break
+            
+    if possible:
+        print("Yes")
+    else:
+        print("No")
+
+if __name__ == "__main__":
+    solve()
