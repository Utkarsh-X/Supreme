+class SessionAuthHashFallbackTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.user = User.objects.create_user("fallback_user", "fallback@example.com", "password")
+
+    @override_settings(
+        SECRET_KEY="new-secret",
+        SECRET_KEY_FALLBACKS=["old-secret"],
+    )
+    def test_get_user_with_secret_key_fallback(self):
+        old_hash = self.user.get_session_auth_hash(secret="old-secret")
+        self.client.force_login(self.user)
+        session = self.client.session
+        session[HASH_SESSION_KEY] = old_hash
+        session.save()
+
+        request = HttpRequest()
+        request.session = session
+        user = get_user(request)
+        self.assertEqual(user, self.user)
+
+    @override_settings(
+        SECRET_KEY="new-secret",
+        SECRET_KEY_FALLBACKS=["old-secret"],
+    )
+    def test_get_user_with_invalid_session_hash(self):
+        self.client.force_login(self.user)
+        session = self.client.session
+        session[HASH_SESSION_KEY] = "invalid-hash"
+        session.save()
+
+        request = HttpRequest()
+        request.session = session
+        user = get_user(request)
+        self.assertTrue(user.is_anonymous)
+
+    @override_settings(
+        SECRET_KEY="new-secret",
+        SECRET_KEY_FALLBACKS=["old-secret"],
+    )
+    def test_login_with_secret_key_fallback(self):
+        old_hash = self.user.get_session_auth_hash(secret="old-secret")
+        self.client.force_login(self.user)
+        session = self.client.session
+        session[HASH_SESSION_KEY] = old_hash
+        session["custom_data"] = "preserve_me"
+        session.save()
+
+        request = HttpRequest()
+        request.session = session
+        login(request, self.user, backend="django.contrib.auth.backends.ModelBackend")
+        self.assertEqual(request.session.get("custom_data"), "preserve_me")
+        self.assertEqual(
+            request.session.get(HASH_SESSION_KEY),
+            self.user.get_session_auth_hash(),
+        )
+
+    @override_settings(
+        SECRET_KEY="new-secret",
+        SECRET_KEY_FALLBACKS=["old-secret"],
+    )
+    def test_get_session_auth_fallback_hashes(self):
+        fallbacks = list(self.user.get_session_auth_fallback_hashes())
+        self.assertEqual(
+            fallbacks,
+            [self.user.get_session_auth_hash(secret="old-secret")],
+        )
+
