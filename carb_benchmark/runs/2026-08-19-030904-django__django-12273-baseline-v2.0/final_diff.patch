+    def test_reset_pk(self):
+        # Child model with custom AutoField pk (Item / Derived)
+        derived = Derived.objects.create(f=True)
+        item = Item.objects.get(pk=derived.pk)
+        obj1 = item.derived
+        obj1.uid = None
+        obj1.f = False
+        obj1.save()
+        self.assertNotEqual(obj1.pk, derived.pk)
+        self.assertEqual(Derived.objects.count(), 2)
+        original_item = Item.objects.get(pk=derived.pk)
+        self.assertTrue(original_item.f)
+
+        # Setting pk = None on child model with custom AutoField pk
+        obj2 = Item.objects.get(pk=derived.pk).derived
+        obj2.pk = None
+        obj2.f = False
+        obj2.save()
+        self.assertNotEqual(obj2.pk, derived.pk)
+        self.assertEqual(Derived.objects.count(), 3)
+
+        # Standard child model (Restaurant / Place)
+        initial_restaurant_count = Restaurant.objects.count()
+        r = Restaurant.objects.create(name="Taco Bell", address="Main St")
+        r_pk = r.pk
+
+        # Resetting pk = None
+        r1 = Restaurant.objects.get(pk=r_pk)
+        r1.pk = None
+        r1.save()
+        self.assertNotEqual(r1.pk, r_pk)
+        self.assertEqual(Restaurant.objects.count(), initial_restaurant_count + 2)
+
+        # Resetting parent pk field (id = None)
+        r2 = Restaurant.objects.get(pk=r_pk)
+        r2.id = None
+        r2.save()
+        self.assertNotEqual(r2.pk, r_pk)
+        self.assertEqual(Restaurant.objects.count(), initial_restaurant_count + 3)
+
+        # Resetting parent link attname (place_ptr_id = None)
+        r3 = Restaurant.objects.get(pk=r_pk)
+        r3.place_ptr_id = None
+        r3.save()
+        self.assertNotEqual(r3.pk, r_pk)
+        self.assertEqual(Restaurant.objects.count(), initial_restaurant_count + 4)
+
+        # Multi-level inheritance (GrandChild)
+        gc = GrandChild.objects.create(
+            first_name="Grand",
+            last_name="Child",
+            email="grandchild@example.com",
+        )
+        gc_pk = gc.pk
+
+        gc1 = GrandChild.objects.get(pk=gc_pk)
+        gc1.pk = None
+        gc1.first_name = "Grand1"
+        gc1.email = "grandchild1@example.com"
+        gc1.save()
+        self.assertNotEqual(gc1.pk, gc_pk)
+        self.assertEqual(GrandChild.objects.count(), 2)
+
+        gc2 = GrandChild.objects.get(pk=gc_pk)
+        gc2.id = None
+        gc2.first_name = "Grand2"
+        gc2.email = "grandchild2@example.com"
+        gc2.save()
+        self.assertNotEqual(gc2.pk, gc_pk)
+        self.assertEqual(GrandChild.objects.count(), 3)
+
+
+
 
