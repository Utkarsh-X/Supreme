+def test_unpickle_dpi():
+    fig = mfigure.Figure(dpi=100)
+    fig.canvas._set_device_pixel_ratio(2)
+    assert fig.dpi == 200
+
+    blob = pickle.dumps(fig)
+    fig2 = pickle.loads(blob)
+    assert fig2.dpi == 200
+
+    blob2 = pickle.dumps(fig2)
+    fig3 = pickle.loads(blob2)
+    assert fig3.dpi == 200
+
+
