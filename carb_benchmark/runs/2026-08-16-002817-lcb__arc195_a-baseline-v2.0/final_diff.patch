-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    N = int(input_data[0])
+    M = int(input_data[1])
+    
+    A = [int(x) for x in input_data[2:2+N]]
+    B = [int(x) for x in input_data[2+N:2+N+M]]
+    
+    # Leftmost greedy matching
+    L = [-1] * M
+    ptr = 0
+    for i in range(N):
+        if ptr < M and A[i] == B[ptr]:
+            L[ptr] = i
+            ptr += 1
+            
+    if ptr < M:
+        print("No")
+        return
+        
+    # Rightmost greedy matching
+    R = [-1] * M
+    ptr = M - 1
+    for i in range(N - 1, -1, -1):
+        if ptr >= 0 and A[i] == B[ptr]:
+            R[ptr] = i
+            ptr -= 1
+            
+    if L == R:
+        print("No")
+    else:
+        print("Yes")
+
+if __name__ == "__main__":
+    main()
