@@ -19,5 +19,20 @@ class TestAuthService(unittest.TestCase):
         with self.assertRaises(ValueError):
             self.service.register_user("charlie@example.com", "NoDigitsHere")
 
+    def test_duplicate_registration(self):
+        self.service.register_user("dave@example.com", "Password123")
+        with self.assertRaises(ValueError):
+            self.service.register_user("dave@example.com", "Password123")
+
+    def test_session_and_audit_log(self):
+        result = self.service.register_user("eve@example.com", "Password123")
+        token = result["token"]
+        self.assertIn(token, self.service.sessions)
+        self.assertEqual(self.service.sessions[token]["email"], "eve@example.com")
+        self.assertEqual(len(self.service.audit_log), 1)
+        self.assertEqual(self.service.audit_log[0]["event"], "user_registered")
+        self.assertEqual(self.service.audit_log[0]["email"], "eve@example.com")
+
+
