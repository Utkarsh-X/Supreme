+class ServerHandlerHEADTests(TestCase):
+    def test_head_request_strips_body(self):
+        env = {
+            "SERVER_PROTOCOL": "HTTP/1.1",
+            "REQUEST_METHOD": "HEAD",
+        }
+        stdout = BytesIO()
+        handler = BaseServerHandler(BytesIO(), stdout, BytesIO(), env)
+        handler.request_handler = DummyHandler()
+        handler.run(wsgi_app)
+        output = stdout.getvalue()
+        self.assertTrue(output.startswith(b"HTTP/1.1 200 OK"))
+        self.assertIn(b"Content-Type: text/plain", output)
+        self.assertTrue(output.endswith(b"\r\n\r\n"))
+
+    def test_get_request_returns_body(self):
+        env = {
+            "SERVER_PROTOCOL": "HTTP/1.1",
+            "REQUEST_METHOD": "GET",
+        }
+        stdout = BytesIO()
+        handler = BaseServerHandler(BytesIO(), stdout, BytesIO(), env)
+        handler.request_handler = DummyHandler()
+        handler.run(wsgi_app)
+        output = stdout.getvalue()
+        self.assertTrue(output.startswith(b"HTTP/1.1 200 OK"))
+        self.assertIn(b"Content-Type: text/plain", output)
+        self.assertTrue(output.endswith(b"\r\n\r\nHello World!"))
+
+    @override_settings(ROOT_URLCONF="builtin_server.urls")
+    def test_head_response_closing(self):
+        env = RequestFactory().head("/fileresponse/").environ
+        stdout = BytesIO()
+        handler = BaseServerHandler(BytesIO(), stdout, BytesIO(), env)
+        handler.request_handler = DummyHandler()
+        handler.run(get_internal_wsgi_application())
+        output = stdout.getvalue()
+        self.assertTrue(output.startswith(b"HTTP/1.1 200 OK"))
+        self.assertNotIn(b"foo", output)
+        self.assertIn("response", FILE_RESPONSE_HOLDER)
+        response = FILE_RESPONSE_HOLDER["response"]
+        self.assertIs(response.closed, True)
+        buf1, buf2 = FILE_RESPONSE_HOLDER["buffers"]
+        self.assertIs(buf1.closed, True)
+        self.assertIs(buf2.closed, True)
+        FILE_RESPONSE_HOLDER.clear()
+
