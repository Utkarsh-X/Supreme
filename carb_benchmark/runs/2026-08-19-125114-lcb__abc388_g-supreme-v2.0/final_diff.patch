-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    iterator = iter(input_data)
+    N = int(next(iterator))
+    
+    A = [int(next(iterator)) for _ in range(N)]
+    
+    Q = int(next(iterator))
+    
+    # Precompute p array using two pointers
+    p = [0] * N
+    ptr = 0
+    for i in range(N):
+        target = 2 * A[i]
+        while ptr < N and A[ptr] < target:
+            ptr += 1
+        p[i] = ptr
+        
+    f = [p[i] - i for i in range(N)]
+    
+    # Build Sparse Table for RMQ (Max)
+    LOG = N.bit_length()
+    st = [f]
+    for k in range(1, LOG):
+        prev = st[k - 1]
+        half = 1 << (k - 1)
+        curr = [0] * (N - (1 << k) + 1)
+        for i in range(len(curr)):
+            c1 = prev[i]
+            c2 = prev[i + half]
+            curr[i] = c1 if c1 > c2 else c2
+        st.append(curr)
+        
+    # Precompute logarithm table
+    lg = [0] * (N + 1)
+    for i in range(2, N + 1):
+        lg[i] = lg[i >> 1] + 1
+        
+    out = []
+    for _ in range(Q):
+        L = int(next(iterator))
+        R = int(next(iterator))
+        l = L - 1
+        r = R - 1
+        M = r - l + 1
+        
+        low = 1
+        high = M >> 1
+        ans = 0
+        
+        while low <= high:
+            mid = (low + high) >> 1
+            # query max of f[l ... l + mid - 1]
+            k = lg[mid]
+            row = st[k]
+            v1 = row[l]
+            v2 = row[l + mid - (1 << k)]
+            max_f = v1 if v1 > v2 else v2
+            
+            if max_f <= r - l - mid + 1:
+                ans = mid
+                low = mid + 1
+            else:
+                high = mid - 1
+                
+        out.append(str(ans))
+        
+    sys.stdout.write('\n'.join(out) + '\n')
+
+if __name__ == '__main__':
+    main()
