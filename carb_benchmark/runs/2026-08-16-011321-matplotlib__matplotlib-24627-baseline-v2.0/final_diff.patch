+def test_cla_clf_clear_deparent():
+    fig = Figure()
+    ax = fig.add_subplot()
+
+    line, = ax.plot([1, 2], label='line')
+    text = ax.text(0.5, 0.5, 'text')
+    ann = ax.annotate('ann', xy=(1, 1), xytext=(0, 0), arrowprops=dict(arrowstyle='->'))
+    leg = ax.legend()
+    tbl = ax.table(cellText=[['a']])
+
+    ax.cla()
+
+    for art in [line, text, ann, ann.arrow_patch, leg, leg.get_texts()[0], tbl, tbl[0, 0]]:
+        assert art.axes is None
+        assert art.figure is None
+
+    ax2 = fig.add_subplot()
+    line2, = ax2.plot([1, 2])
+    figtext = fig.text(0.5, 0.5, 'figtext')
+
+    fig.clf()
+
+    for art in [ax2, line2, figtext]:
+        assert art.axes is None
+        assert art.figure is None
+
+    ax3 = fig.add_subplot()
+    fig.delaxes(ax3)
+    assert ax3.axes is None
+    assert ax3.figure is None
+
