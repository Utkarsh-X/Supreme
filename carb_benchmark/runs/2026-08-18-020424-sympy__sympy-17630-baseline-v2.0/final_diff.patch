+def test_zero_matrix_block_mult():
+    a = MatrixSymbol("a", 2, 2)
+    z = ZeroMatrix(2, 2)
+    b = BlockMatrix([[a, z], [z, z]])
+    assert block_collapse(b * b * b) == BlockMatrix([[a**3, z], [z, z]])
+    assert b._blockmul(b)._blockmul(b) == BlockMatrix([[a**3, z], [z, z]])
