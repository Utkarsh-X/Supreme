-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    iterator = iter(input_data)
+    N = int(next(iterator))
+    
+    W = [int(next(iterator)) for _ in range(N)]
+    
+    L = [0] * N
+    R = [0] * N
+    max_coord = 2 * N
+    for i in range(N):
+        l = int(next(iterator))
+        r = int(next(iterator))
+        L[i] = l
+        R[i] = r
+        if r > max_coord:
+            max_coord = r
+            
+    Q = int(next(iterator))
+    
+    MAX_COORD = max_coord + 2
+    
+    by_R = [[] for _ in range(MAX_COORD + 1)]
+    by_L = [[] for _ in range(MAX_COORD + 1)]
+    
+    for i in range(N):
+        by_R[R[i]].append(i)
+        by_L[L[i]].append(i)
+        
+    for coord in range(MAX_COORD + 1):
+        if len(by_R[coord]) > 4:
+            by_R[coord].sort(key=lambda x: W[x])
+            by_R[coord] = by_R[coord][:4]
+        if len(by_L[coord]) > 4:
+            by_L[coord].sort(key=lambda x: W[x])
+            by_L[coord] = by_L[coord][:4]
+            
+    def merge_top4(list1, list2):
+        if not list1: return list2
+        if not list2: return list1
+        seen = set(list1)
+        res = list(list1)
+        for x in list2:
+            if x not in seen:
+                res.append(x)
+        res.sort(key=lambda x: W[x])
+        return res[:4]
+        
+    prefix_R = [[] for _ in range(MAX_COORD + 1)]
+    curr = []
+    for r in range(1, MAX_COORD + 1):
+        curr = merge_top4(curr, by_R[r-1])
+        prefix_R[r] = curr
+        
+    suffix_L = [[] for _ in range(MAX_COORD + 1)]
+    curr = []
+    for l in range(MAX_COORD - 1, -1, -1):
+        curr = merge_top4(curr, by_L[l+1])
+        suffix_L[l] = curr
+        
+    out = []
+    INF = 10**18
+    
+    for _ in range(Q):
+        s = int(next(iterator)) - 1
+        t = int(next(iterator)) - 1
+        
+        Ls, Rs, Ws = L[s], R[s], W[s]
+        Lt, Rt, Wt = L[t], R[t], W[t]
+        
+        # 1-step
+        if Rs < Lt or Rt < Ls:
+            out.append(str(Ws + Wt))
+            continue
+            
+        ans = INF
+        
+        # 2-step
+        limit_left = Ls if Ls < Lt else Lt
+        for m in prefix_R[limit_left]:
+            if m != s and m != t:
+                w = Ws + W[m] + Wt
+                if w < ans: ans = w
+                
+        limit_right = Rs if Rs > Rt else Rt
+        for m in suffix_L[limit_right]:
+            if m != s and m != t:
+                w = Ws + W[m] + Wt
+                if w < ans: ans = w
+                
+        # 3-step
+        # Combo 1: u right of s (L_u > Rs), v left of t (R_v < Lt)
+        cand_u1 = suffix_L[Rs]
+        cand_v1 = prefix_R[Lt]
+        for u in cand_u1:
+            if u == s or u == t: continue
+            Wu = W[u]
+            for v in cand_v1:
+                if v == s or v == t or v == u: continue
+                w = Ws + Wu + W[v] + Wt
+                if w < ans: ans = w
+                
+        # Combo 2: u left of s (R_u < Ls), v right of t (L_v > Rt)
+        cand_u2 = prefix_R[Ls]
+        cand_v2 = suffix_L[Rt]
+        for u in cand_u2:
+            if u == s or u == t: continue
+            Wu = W[u]
+            for v in cand_v2:
+                if v == s or v == t or v == u: continue
+                w = Ws + Wu + W[v] + Wt
+                if w < ans: ans = w
+                
+        if ans != INF:
+            out.append(str(ans))
+        else:
+            out.append("-1")
+            
+    sys.stdout.write("\n".join(out) + "\n")
+
+if __name__ == '__main__':
+    main()
