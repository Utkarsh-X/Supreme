-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    A = [int(x) for x in input_data[1:N+1]]
+    
+    ans = 0
+    i = 0
+    for j in range(N):
+        limit = A[j] // 2
+        while i < N and A[i] <= limit:
+            i += 1
+        ans += i
+        
+    print(ans)
+
+if __name__ == '__main__':
+    main()
