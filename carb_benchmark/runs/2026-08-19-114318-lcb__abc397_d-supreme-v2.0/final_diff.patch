-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import math
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    
+    d = 1
+    while d * d * d < N:
+        if N % d == 0:
+            k = N // d
+            delta = 3 * (4 * k - d * d)
+            s = math.isqrt(delta)
+            if s * s == delta:
+                num = s - 3 * d
+                if num > 0 and num % 6 == 0:
+                    y = num // 6
+                    x = y + d
+                    print(f"{x} {y}")
+                    return
+        d += 1
+        
+    print("-1")
+
+if __name__ == "__main__":
+    main()
