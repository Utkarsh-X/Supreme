@@ -184,3 +184,42 @@ def test_build_single_pot(app):
          'msgid "Generated section".*'),
         result,
         flags=re.S)
+
+
+def test_message_unique_locations():
+    from sphinx.builders.gettext import Message
+    locations = [
+        ('index.rst', 10),
+        ('index.rst', 0),
+        ('index.rst', 0),
+        ('index.rst', 0),
+        ('index.rst', 12),
+        ('index.rst', 10),
+    ]
+    uuids = ['id1', 'id2', 'id3', 'id4', 'id5', 'id6']
+    msg = Message('test', locations, uuids)
+    assert msg.locations == [
+        ('index.rst', 10),
+        ('index.rst', 0),
+        ('index.rst', 12),
+    ]
+
+
+def test_catalog_unique_locations():
+    from sphinx.builders.gettext import Catalog, MsgOrigin
+    catalog = Catalog()
+    origin1 = MsgOrigin('index.rst', 0)
+    origin2 = MsgOrigin('index.rst', 0)
+    origin3 = MsgOrigin('index.rst', 10)
+
+    catalog.add('message', origin1)
+    catalog.add('message', origin2)
+    catalog.add('message', origin3)
+
+    messages = list(catalog)
+    assert len(messages) == 1
+    assert messages[0].locations == [
+        ('index.rst', 0),
+        ('index.rst', 10),
+    ]
+
