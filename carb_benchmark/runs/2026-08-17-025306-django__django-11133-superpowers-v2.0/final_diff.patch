+
+    def test_memoryview(self):
+        response = HttpResponse(memoryview(b'Memoryview content'))
+        self.assertEqual(response.content, b'Memoryview content')
+        response = HttpResponse(memoryview(bytearray(b'Memoryview content')))
+        self.assertEqual(response.content, b'Memoryview content')
+        response = HttpResponse([memoryview(b'Memoryview content')])
+        self.assertEqual(response.content, b'Memoryview content')
+        response = HttpResponse()
+        response.write(memoryview(b'Memoryview content'))
+        self.assertEqual(response.content, b'Memoryview content')
+        response = StreamingHttpResponse([memoryview(b'Memoryview content')])
+        self.assertEqual(b''.join(response), b'Memoryview content')
