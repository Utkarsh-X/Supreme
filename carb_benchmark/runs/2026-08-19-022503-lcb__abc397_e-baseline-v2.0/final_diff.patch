-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    N = int(input_data[0])
+    K = int(input_data[1])
+    V = N * K
+    
+    if V == 1:
+        print("Yes")
+        return
+
+    adj = [[] for _ in range(V + 1)]
+    idx = 2
+    for _ in range(V - 1):
+        u = int(input_data[idx])
+        v = int(input_data[idx + 1])
+        adj[u].append(v)
+        adj[v].append(u)
+        idx += 2
+
+    # BFS from root 1
+    parent = [0] * (V + 1)
+    order = []
+    order.append(1)
+    visited = [False] * (V + 1)
+    visited[1] = True
+
+    head = 0
+    while head < len(order):
+        u = order[head]
+        head += 1
+        for v in adj[u]:
+            if not visited[v]:
+                visited[v] = True
+                parent[v] = u
+                order.append(v)
+
+    # Process in reverse BFS order
+    size = [1] * (V + 1)
+    R = [0] * (V + 1)
+    S = [0] * (V + 1)
+
+    for u in reversed(order):
+        R[u] = size[u] % K
+        limit = 1 if R[u] > 0 else 2
+        if S[u] > limit:
+            print("No")
+            return
+        
+        p = parent[u]
+        if p != 0:
+            size[p] += size[u]
+            if R[u] > 0:
+                S[p] += 1
+
+    print("Yes")
+
+if __name__ == '__main__':
+    solve()
