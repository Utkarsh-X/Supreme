diff --git a/sympy/sets/contains.py b/sympy/sets/contains.py
index b2d4268..79b6b18 100644
--- a/sympy/sets/contains.py
+++ b/sympy/sets/contains.py
@@ -44,5 +44,26 @@ def binary_symbols(self):
             if i.is_Boolean or i.is_Symbol or
             isinstance(i, (Eq, Ne))])
 
-    def as_set(self):
-        raise NotImplementedError()
+    def _eval_as_set(self):
+        from sympy.sets.conditionset import ConditionSet
+        from sympy.core.symbol import Symbol
+
+        expr, set_ = self.args
+        if isinstance(expr, Symbol) and expr not in set_.free_symbols:
+            return set_
+
+        if isinstance(set_, Set):
+            try:
+                rel = set_.as_relational(expr)
+            except (NotImplementedError, AttributeError):
+                pass
+            else:
+                if not isinstance(rel, Contains):
+                    return rel.as_set()
+
+        syms = self.free_symbols
+        if len(syms) == 1:
+            x = syms.pop()
+            return ConditionSet(x, self, S.Reals)
+        raise NotImplementedError("multivariate as_set is not implemented for Contains")
+
diff --git a/sympy/sets/tests/test_contains.py b/sympy/sets/tests/test_contains.py
index 1973fed..41787b1 100644
--- a/sympy/sets/tests/test_contains.py
+++ b/sympy/sets/tests/test_contains.py
@@ -41,11 +41,17 @@ def test_binary_symbols():
 def test_as_set():
     x = Symbol('x')
     y = Symbol('y')
-    # Contains is a BooleanFunction whose value depends on an arg's
-    # containment in a Set -- rewriting as a Set is not yet implemented
+    assert Contains(x, S.Reals).as_set() == S.Reals
+    assert Contains(x, S.Integers).as_set() == S.Integers
+    assert Contains(x, Interval(0, 1)).as_set() == Interval(0, 1)
+    assert Contains(x, FiniteSet(1, 2)).as_set() == FiniteSet(1, 2)
+    assert Contains(x + 1, Interval(0, 5)).as_set() == Interval(-1, 4)
+
+    # Contains with multiple free symbols raises NotImplementedError
     raises(NotImplementedError, lambda:
            Contains(x, FiniteSet(y)).as_set())
 
+
 def test_type_error():
     # Pass in a parameter not of type "set"
     raises(TypeError, lambda: Contains(2, None))
