+    def test_union_with_ordering_on_derived_qs(self):
+        qs = Number.objects.filter(num__in=[0, 1]).union(
+            Number.objects.filter(num__in=[2, 3])
+        ).order_by('num')
+        self.assertEqual(list(qs.order_by().values_list('num', flat=True)), [0, 1, 2, 3])
+        self.assertNumbersEqual(qs, [0, 1, 2, 3])
+
+    def test_union_with_meta_ordering(self):
+        from .models import Tag
+        Tag.objects.create(name='t1')
+        Tag.objects.create(name='t2')
+        qs1 = Tag.objects.filter(name='t1')
+        qs2 = Tag.objects.filter(name='t2')
+        self.assertEqual(len(qs1.union(qs2)), 2)
