+    def test_y_format_year_before_1000(self):
+        tests = [
+            (datetime(1, 1, 1), '01'),
+            (datetime(9, 1, 1), '09'),
+            (datetime(99, 1, 1), '99'),
+            (datetime(123, 1, 1), '23'),
+            (datetime(999, 1, 1), '99'),
+        ]
+        for dt, expected in tests:
+            with self.subTest(dt=dt):
+                self.assertEqual(dateformat.format(dt, 'y'), expected)
+
     def test_futuredates(self):
         the_future = datetime(2100, 10, 25, 0, 00)
