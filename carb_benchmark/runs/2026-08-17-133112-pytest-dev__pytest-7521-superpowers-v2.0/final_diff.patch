index a3bd4b6..21ef1f2 100644
--- a/testing/test_capture.py
+++ b/testing/test_capture.py
@@ -1580,3 +1580,26 @@ def test_logging_while_collecting(testdir):
     )
     result.stdout.no_fnmatch_line("*Captured stderr call*")
     result.stdout.no_fnmatch_line("*during collection*")
+
+
+@pytest.mark.parametrize("capture_fixture", ["capsys", "capfd"])
+def test_capture_carriage_return(testdir, capture_fixture):
+    testdir.makepyfile(
+        """
+        import sys
+
+        def test_cr({0}):
+            print("Greetings from DOS", end="\\r")
+            captured = {0}.readouterr()
+            assert captured.out == "Greetings from DOS\\r"
+
+            sys.stderr.write("stderr DOS\\r")
+            captured = {0}.readouterr()
+            assert captured.err == "stderr DOS\\r"
+        """.format(
+            capture_fixture
+        )
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*1 passed*"])
+
