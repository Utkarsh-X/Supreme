+    def test_date_serialization(self):
+        today = datetime.date(2026, 8, 14)
+        data = {"created_date": today}
+        serialized = self.serializer.serialize(data)
+        self.assertIn("2026-08-14", serialized)
+
+    def test_combined_serialization(self):
+        session_id = uuid.uuid4()
+        now = datetime.datetime(2026, 8, 14, 20, 0, 0)
+        data = {
+            "session_id": session_id,
+            "created_at": now,
+            "user": "bob"
+        }
+        serialized = self.serializer.serialize(data)
+        self.assertIn(str(session_id), serialized)
+        self.assertIn("2026-08-14T20:00:00", serialized)
+        deserialized = self.serializer.deserialize(serialized)
+        self.assertEqual(deserialized["session_id"], str(session_id))
+        self.assertEqual(deserialized["created_at"], "2026-08-14T20:00:00")
+        self.assertEqual(deserialized["user"], "bob")
+
 if __name__ == "__main__":
     unittest.main()
