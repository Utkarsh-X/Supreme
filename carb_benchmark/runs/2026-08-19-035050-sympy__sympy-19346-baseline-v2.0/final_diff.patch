+def test_set():
+    sT({x, Integer(4)}, "{Integer(4), Symbol('x')}")
+    sT({x, y}, "{Symbol('x'), Symbol('y')}")
+    sT(set(), "set()")
+
+
+def test_frozenset():
+    sT(frozenset([x, Integer(4)]), "frozenset({Integer(4), Symbol('x')})")
