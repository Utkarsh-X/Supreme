-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    n = int(input_data[0])
+    a = list(map(int, input_data[1:n+1]))
+    
+    last_pos = {}
+    ans = float('inf')
+    
+    for i, val in enumerate(a):
+        if val in last_pos:
+            ans = min(ans, i - last_pos[val] + 1)
+        last_pos[val] = i
+        
+    if ans == float('inf'):
+        print(-1)
+    else:
+        print(ans)
+
+if __name__ == '__main__':
+    main()
