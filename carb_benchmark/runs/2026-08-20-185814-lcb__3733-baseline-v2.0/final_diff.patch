--- a/main.py
+++ b/main.py
@@ -1 +1,119 @@
-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import json
+import ast
+
+def solve():
+    content = sys.stdin.read().strip()
+    if not content:
+        print(0)
+        return
+    try:
+        grid = json.loads(content)
+    except Exception:
+        try:
+            grid = ast.literal_eval(content)
+        except Exception:
+            print(0)
+            return
+
+    if not grid or not grid[0]:
+        print(0)
+        return
+
+    n = len(grid)
+    m = len(grid[0])
+
+    # Directions in clockwise order:
+    # 0: Up-Right (-1, 1)
+    # 1: Down-Right (1, 1)
+    # 2: Down-Left (1, -1)
+    # 3: Up-Left (-1, -1)
+    DIRS = [(-1, 1), (1, 1), (1, -1), (-1, -1)]
+
+    # dp[r][c][d] = length of valid alternating sequence (2, 0, 2, 0...)
+    # starting at grid[r][c] in direction d.
+    dp = [[[0] * 4 for _ in range(m)] for _ in range(n)]
+
+    # Direction 0: dr=-1, dc=1 -> depends on (r-1, c+1)
+    for r in range(n):
+        for c in range(m - 1, -1, -1):
+            val = grid[r][c]
+            if val == 0 or val == 2:
+                nr, nc = r - 1, c + 1
+                if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 2 - val:
+                    dp[r][c][0] = 1 + dp[nr][nc][0]
+                else:
+                    dp[r][c][0] = 1
+
+    # Direction 1: dr=1, dc=1 -> depends on (r+1, c+1)
+    for r in range(n - 1, -1, -1):
+        for c in range(m - 1, -1, -1):
+            val = grid[r][c]
+            if val == 0 or val == 2:
+                nr, nc = r + 1, c + 1
+                if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 2 - val:
+                    dp[r][c][1] = 1 + dp[nr][nc][1]
+                else:
+                    dp[r][c][1] = 1
+
+    # Direction 2: dr=1, dc=-1 -> depends on (r+1, c-1)
+    for r in range(n - 1, -1, -1):
+        for c in range(m):
+            val = grid[r][c]
+            if val == 0 or val == 2:
+                nr, nc = r + 1, c - 1
+                if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 2 - val:
+                    dp[r][c][2] = 1 + dp[nr][nc][2]
+                else:
+                    dp[r][c][2] = 1
+
+    # Direction 3: dr=-1, dc=-1 -> depends on (r-1, c-1)
+    for r in range(n):
+        for c in range(m):
+            val = grid[r][c]
+            if val == 0 or val == 2:
+                nr, nc = r - 1, c - 1
+                if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 2 - val:
+                    dp[r][c][3] = 1 + dp[nr][nc][3]
+                else:
+                    dp[r][c][3] = 1
+
+    max_len = 0
+
+    for r0 in range(n):
+        for c0 in range(m):
+            if grid[r0][c0] == 1:
+                max_len = max(max_len, 1)
+                for d in range(4):
+                    dr, dc = DIRS[d]
+                    
+                    # Straight path starting from (r0, c0) in direction d
+                    nr, nc = r0 + dr, c0 + dc
+                    if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 2:
+                        max_len = max(max_len, 1 + dp[nr][nc][d])
+
+                    # Walk along direction d and check 90-degree clockwise turns
+                    r, c = r0 + dr, c0 + dc
+                    k = 1
+                    while 0 <= r < n and 0 <= c < m:
+                        expected = 2 if k % 2 == 1 else 0
+                        if grid[r][c] != expected:
+                            break
+                        
+                        max_len = max(max_len, k + 1)
+                        
+                        # Turn 90-degree clockwise at (r, c)
+                        d_next = (d + 1) % 4
+                        dr_next, dc_next = DIRS[d_next]
+                        nr_turn, nc_turn = r + dr_next, c + dc_next
+                        if 0 <= nr_turn < n and 0 <= nc_turn < m and grid[nr_turn][nc_turn] == 2 - expected:
+                            max_len = max(max_len, (k + 1) + dp[nr_turn][nc_turn][d_next])
+                            
+                        r += dr
+                        c += dc
+                        k += 1
+
+    print(max_len)
+
+if __name__ == '__main__':
+    solve()
