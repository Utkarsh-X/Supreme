@@ -19,5 +19,17 @@ class TestAuthService(unittest.TestCase):
         with self.assertRaises(ValueError):
             self.service.register_user("charlie@example.com", "NoDigitsHere")
 
+    def test_duplicate_user(self):
+        self.service.register_user("alice@example.com", "Password123")
+        with self.assertRaises(ValueError):
+            self.service.register_user("alice@example.com", "Password456")
+
+    def test_session_and_audit_log(self):
+        result = self.service.register_user("dave@example.com", "ValidPass1")
+        token = result["token"]
+        self.assertIn(token, self.service.sessions)
+        self.assertEqual(self.service.sessions[token]["email"], "dave@example.com")
+        self.assertTrue(any(log["event"] == "user_registered" and log["email"] == "dave@example.com" for log in self.service.audit_log))
+
