-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def solve():
+    input_data = sys.stdin.buffer.read().split()
+    if not input_data:
+        return
+    
+    it = iter(input_data)
+    N = int(next(it))
+    
+    contests = [(int(next(it)), int(next(it))) for _ in range(N)]
+        
+    Q_num = int(next(it))
+    queries = [int(next(it)) for _ in range(Q_num)]
+    
+    M = 500000
+    tree = [0] * (M + 2)
+    diff = [0] * (M + 2)
+    
+    POWERS = (262144, 131072, 65536, 32768, 16384, 8192, 4096, 2048, 1024, 512, 256, 128, 64, 32, 16, 8, 4, 2, 1)
+    
+    for L, R in contests:
+        # Find x_min: first x where F(x) >= L (i.e. last x where F(x) < L, plus 1)
+        idx = 0
+        cur_sum = 0
+        for pw in POWERS:
+            nxt = idx + pw
+            if nxt <= M:
+                val = nxt + cur_sum + tree[nxt]
+                if val < L:
+                    idx = nxt
+                    cur_sum += tree[nxt]
+        x_min = idx + 1
+        
+        # Find x_max: last x where F(x) <= R
+        idx = 0
+        cur_sum = 0
+        for pw in POWERS:
+            nxt = idx + pw
+            if nxt <= M:
+                val = nxt + cur_sum + tree[nxt]
+                if val <= R:
+                    idx = nxt
+                    cur_sum += tree[nxt]
+        x_max = idx
+        
+        if x_min <= x_max:
+            # Update BIT
+            i = x_min
+            while i <= M:
+                tree[i] += 1
+                i += i & -i
+                
+            i = x_max + 1
+            while i <= M:
+                tree[i] -= 1
+                i += i & -i
+                
+            # Update diff array
+            diff[x_min] += 1
+            if x_max + 1 <= M + 1:
+                diff[x_max + 1] -= 1
+
+    # Reconstruct final ratings for 1..M
+    ans = [0] * (M + 1)
+    cur_diff = 0
+    for x in range(1, M + 1):
+        cur_diff += diff[x]
+        ans[x] = x + cur_diff
+        
+    out = [str(ans[q]) for q in queries]
+    sys.stdout.write('\n'.join(out) + '\n')
+
+if __name__ == '__main__':
+    solve()
