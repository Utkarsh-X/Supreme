diff --git a/lib/matplotlib/tests/test_axes.py b/lib/matplotlib/tests/test_axes.py
index e70bfc7..2275e36 100644
--- a/lib/matplotlib/tests/test_axes.py
+++ b/lib/matplotlib/tests/test_axes.py
@@ -8382,3 +8382,30 @@ def test_scatter_color_repr_error():
         c = 'red\n'
         mpl.axes.Axes._parse_scatter_color_args(
             c, None, kwargs={}, xsize=2, get_next_color_func=get_next_color)
+
+
+def test_cla_clf_clears_axes_and_figure():
+    fig, ax = plt.subplots()
+    l, = ax.plot([1, 2], label='line')
+    c = ax.scatter([1], [2])
+    p, = ax.fill([0, 1, 1, 0], [0, 0, 1, 1])
+    t = ax.text(0, 0, 'hi')
+    leg = ax.legend()
+    tbl = ax.table([[1]])
+
+    ax.clear()
+    for art in [l, c, p, t, leg, tbl]:
+        assert art.axes is None
+        assert art.figure is None
+
+    fig, ax = plt.subplots()
+    l, = ax.plot([1, 2])
+    st = fig.suptitle('Title')
+    fig.clear()
+    assert l.axes is None
+    assert l.figure is None
+    assert ax.axes is None
+    assert ax.figure is None
+    assert st.axes is None
+    assert st.figure is None
+
