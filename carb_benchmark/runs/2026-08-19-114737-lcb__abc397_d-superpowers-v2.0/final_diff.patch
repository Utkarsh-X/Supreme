-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import math
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+
+    if N <= 0:
+        print(-1)
+        return
+
+    # We need x^3 - y^3 = N with x > y >= 1.
+    # Let d = x - y. Then d >= 1 and d^3 < N, so d <= floor((N-1)^(1/3)).
+    # N = d * (3*y^2 + 3*d*y + d^2).
+
+    limit = int((N - 1) ** (1 / 3))
+    while (limit + 1) ** 3 <= N - 1:
+        limit += 1
+        
+    while limit > 0 and limit ** 3 > N - 1:
+        limit -= 1
+
+    for d in range(1, limit + 1):
+        if N % d == 0:
+            K = N // d
+            # 3*y^2 + 3*d*y + d^2 - K = 0
+            # D = (3d)^2 - 4*3*(d^2 - K) = 9d^2 - 12d^2 + 12K = 12K - 3d^2
+            D = 12 * K - 3 * d * d
+            if D >= 0:
+                s = math.isqrt(D)
+                if s * s == D:
+                    num = s - 3 * d
+                    if num > 0 and num % 6 == 0:
+                        y = num // 6
+                        x = y + d
+                        print(f"{x} {y}")
+                        return
+
+    print(-1)
+
+if __name__ == '__main__':
+    solve()
