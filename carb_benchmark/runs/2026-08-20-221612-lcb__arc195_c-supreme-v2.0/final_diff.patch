-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    T = int(input_data[0])
+    idx = 1
+    
+    out = []
+    
+    for _ in range(T):
+        R = int(input_data[idx])
+        B = int(input_data[idx+1])
+        idx += 2
+        
+        # Parity conditions:
+        # 1. R must be even.
+        # 2. If R == 0, B must be even.
+        if R % 2 != 0 or (R == 0 and B % 2 != 0):
+            out.append("No")
+            continue
+            
+        out.append("Yes")
+        r0, c0 = 500000000, 500000000
+        
+        if R == 0:
+            k = B // 2
+            for j in range(k):
+                out.append(f"B {r0 + j} {c0 + j}")
+            for j in range(k - 1, -1, -1):
+                out.append(f"B {r0 + 1 + j} {c0 - 1 + j}")
+            continue
+            
+        if B == 0:
+            m = R // 2
+            if m == 1:
+                out.append(f"R {r0} {c0}")
+                out.append(f"R {r0 + 1} {c0}")
+            else:
+                for x in range(m):
+                    out.append(f"R {r0 + x} {c0}")
+                for x in range(m - 1, -1, -1):
+                    out.append(f"R {r0 + x} {c0 + 1}")
+            continue
+            
+        if B == 1:
+            m = R // 2
+            for x in range(m + 1):
+                out.append(f"R {r0 + x} {c0}")
+            for x in range(m, 1, -1):
+                out.append(f"R {r0 + x} {c0 + 1}")
+            out.append(f"B {r0 + 1} {c0 + 1}")
+            continue
+            
+        # R >= 2 (even) and B >= 2
+        k_top = B // 2
+        k_bot = B - 1 - k_top
+        
+        blue_v = []
+        for j in range(k_top + 1):
+            blue_v.append((r0 + j, c0 + j))
+        for j in range(k_top, k_top - k_bot - 1, -1):
+            blue_v.append((r0 + 1 + j, c0 - 1 + j))
+            
+        for i in range(B):
+            out.append(f"B {blue_v[i][0]} {blue_v[i][1]}")
+            
+        if R == 2:
+            if B % 2 == 0:
+                out.append(f"R {r0 + 2} {c0}")
+                out.append(f"R {r0 + 1} {c0}")
+            else:
+                out.append(f"R {r0 + 1} {c0 - 1}")
+                out.append(f"R {r0} {c0 - 1}")
+            continue
+            
+        # R >= 4 (even)
+        if B % 2 == 0:
+            if R == 4:
+                out.append(f"R {r0 + 2} {c0}")
+                out.append(f"R {r0 + 2} {c0 - 1}")
+                out.append(f"R {r0 + 1} {c0 - 1}")
+                out.append(f"R {r0} {c0 - 1}")
+            else:
+                out.append(f"R {r0 + 2} {c0}")
+                h = (R - 4) // 2
+                for r in range(r0 + 2, r0 + 2 + h):
+                    out.append(f"R {r} {c0 - 1}")
+                for r in range(r0 + 1 + h, r0 - 1, -1):
+                    out.append(f"R {r} {c0 - 2}")
+                out.append(f"R {r0} {c0 - 1}")
+        else:
+            if R == 4:
+                out.append(f"R {r0 + 1} {c0 - 1}")
+                out.append(f"R {r0 + 1} {c0 - 2}")
+                out.append(f"R {r0} {c0 - 2}")
+                out.append(f"R {r0} {c0 - 1}")
+            else:
+                m = R // 2
+                for r in range(r0 + 1, r0 + m):
+                    out.append(f"R {r} {c0 - 1}")
+                for r in range(r0 + m - 1, r0 - 1, -1):
+                    out.append(f"R {r} {c0 - 2}")
+                out.append(f"R {r0} {c0 - 1}")
+
+    sys.stdout.write("\n".join(out) + "\n")
+
+if __name__ == '__main__':
+    solve()
