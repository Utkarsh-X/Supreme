-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    MOD = 998244353
+    
+    N = int(input_data[0])
+    Q = int(input_data[1])
+    
+    A = [0] * (N + 1)
+    idx = 2
+    for i in range(2, N + 1):
+        A[i] = int(input_data[idx])
+        idx += 1
+        
+    fact = 1
+    for i in range(1, N):
+        fact = (fact * i) % MOD
+        
+    inv = [0] * (N + 2)
+    inv[1] = 1
+    for i in range(2, N + 2):
+        inv[i] = (MOD - (MOD // i) * inv[MOD % i]) % MOD
+
+    S1 = [0] * (N + 2)
+    for k in range(2, N + 1):
+        term = A[k] * 2 % MOD * (k - 1) % MOD * inv[k] % MOD * inv[k + 1] % MOD
+        S1[k + 1] = (S1[k] + term) % MOD
+
+    S2 = [0] * (N + 2)
+    for k in range(2, N + 1):
+        term = A[k] * inv[k] % MOD
+        S2[k] = (S2[k - 1] + term) % MOD
+        
+    out = []
+    for _ in range(Q):
+        u = int(input_data[idx])
+        v = int(input_data[idx + 1])
+        idx += 2
+        
+        if u > v:
+            u, v = v, u
+            
+        exp_dist = (S1[u] + A[u] * (u - 1) % MOD * inv[u] + S2[v - 1] - S2[u] + A[v]) % MOD
+        out.append(str((fact * exp_dist) % MOD))
+        
+    sys.stdout.write('\n'.join(out) + '\n')
+
+if __name__ == '__main__':
+    main()
