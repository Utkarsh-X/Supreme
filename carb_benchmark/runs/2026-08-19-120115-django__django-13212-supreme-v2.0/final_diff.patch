diff --git a/tests/validators/tests.py b/tests/validators/tests.py
index d6d013c..eac21c5 100644
--- a/tests/validators/tests.py
+++ b/tests/validators/tests.py
@@ -354,6 +354,42 @@ class TestValidators(SimpleTestCase):
         with self.assertRaisesMessage(ValidationError, '"djangoproject.com" has more than 16 characters.'):
             v('djangoproject.com')
 
+    def test_validators_value_in_params(self):
+        file_path = ContentFile(b'', name='file.png')
+        tests = [
+            (RegexValidator(r'^a$'), 'b'),
+            (URLValidator(), 'invalid_url'),
+            (EmailValidator(), 'invalid_email'),
+            (validate_integer, 'invalid_int'),
+            (validate_ipv4_address, 'invalid_ipv4'),
+            (validate_ipv6_address, 'invalid_ipv6'),
+            (validate_ipv46_address, 'invalid_ipv46'),
+            (DecimalValidator(1, 1), Decimal('12.3')),
+            (FileExtensionValidator(['txt']), file_path),
+            (ProhibitNullCharactersValidator(), 'null\x00character'),
+        ]
+        for validator, value in tests:
+            with self.subTest(validator=validator, value=value):
+                with self.assertRaises(ValidationError) as cm:
+                    validator(value)
+                self.assertIn('value', cm.exception.params)
+                self.assertEqual(cm.exception.params['value'], value)
+
+    def test_validator_custom_message_value_placeholder(self):
+        file_path = ContentFile(b'', name='file.png')
+        tests = [
+            (RegexValidator(r'^a$', message='%(value)s is invalid'), 'b', 'b is invalid'),
+            (URLValidator(message='%(value)s is invalid url'), 'invalid_url', 'invalid_url is invalid url'),
+            (EmailValidator(message='%(value)s is invalid email'), 'invalid_email', 'invalid_email is invalid email'),
+            (ProhibitNullCharactersValidator(message='%(value)s has null'), 'a\x00b', 'a\x00b has null'),
+            (FileExtensionValidator(['txt'], message='%(value)s invalid ext'), file_path, '%s invalid ext' % file_path),
+        ]
+        for validator, value, expected_message in tests:
+            with self.subTest(validator=validator, value=value):
+                with self.assertRaises(ValidationError) as cm:
+                    validator(value)
+                self.assertEqual(cm.exception.messages, [expected_message])
+
 
