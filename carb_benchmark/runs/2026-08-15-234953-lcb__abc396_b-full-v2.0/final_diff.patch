-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    Q = int(input_data[0])
+    stack = [0] * 100
+    
+    idx = 1
+    out = []
+    for _ in range(Q):
+        qtype = int(input_data[idx])
+        idx += 1
+        if qtype == 1:
+            x = int(input_data[idx])
+            idx += 1
+            stack.append(x)
+        else:
+            out.append(str(stack.pop()))
+            
+    print('\n'.join(out))
+
+if __name__ == '__main__':
+    main()
