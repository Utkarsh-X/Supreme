diff --git a/astropy/coordinates/tests/test_sky_coord.py b/astropy/coordinates/tests/test_sky_coord.py
index 4dcfba0..401eb31 100644
--- a/astropy/coordinates/tests/test_sky_coord.py
+++ b/astropy/coordinates/tests/test_sky_coord.py
@@ -2165,3 +2165,42 @@ def test_match_to_catalog_3d_and_sky():
     npt.assert_array_equal(idx, [0, 1, 2, 3])
     assert_allclose(angle, 0 * u.deg, atol=1e-14 * u.deg, rtol=0)
     assert_allclose(distance, 0 * u.kpc, atol=1e-14 * u.kpc, rtol=0)
+
+
+def test_subclass_skycoord_attribute_error():
+    # Regression test for issue where accessing a custom property on a subclassed
+    # SkyCoord (or frame) that raised an AttributeError resulted in a misleading
+    # AttributeError claiming the property itself didn't exist.
+
+    class CustomCoord(SkyCoord):
+        @property
+        def prop(self):
+            return self.random_attr
+
+        @property
+        def frame_prop(self):
+            return self.frame.non_existent
+
+    c = CustomCoord("00h42m30s", "+41d12m00s", frame="icrs")
+    with pytest.raises(
+        AttributeError, match="'CustomCoord' object has no attribute 'random_attr'"
+    ):
+        c.prop
+
+    with pytest.raises(
+        AttributeError, match="'ICRS' object has no attribute 'non_existent'"
+    ):
+        c.frame_prop
+
+    class CustomFrame(ICRS):
+        @property
+        def custom_frame_prop(self):
+            return self.non_existent_attr
+
+    sc = SkyCoord(CustomFrame(ra="00h42m30s", dec="+41d12m00s"))
+    with pytest.raises(
+        AttributeError,
+        match="'CustomFrame' object has no attribute 'non_existent_attr'",
+    ):
+        sc.custom_frame_prop
+
