+    @isolate_apps('model_inheritance')
+    def test_multiple_onetoone_to_parent(self):
+        class Document(models.Model):
+            pass
+
+        class PickingFirst(Document):
+            document_ptr = models.OneToOneField(
+                Document,
+                on_delete=models.CASCADE,
+                parent_link=True,
+                related_name='+',
+            )
+            origin = models.OneToOneField(
+                Document,
+                on_delete=models.PROTECT,
+                related_name='picking_first',
+            )
+
+        class PickingSecond(Document):
+            origin = models.OneToOneField(
+                Document,
+                on_delete=models.PROTECT,
+                related_name='picking_second',
+            )
+            document_ptr = models.OneToOneField(
+                Document,
+                on_delete=models.CASCADE,
+                parent_link=True,
+                related_name='+',
+            )
+
+        self.assertIs(PickingFirst._meta.parents[Document], PickingFirst._meta.get_field('document_ptr'))
+        self.assertIs(PickingSecond._meta.parents[Document], PickingSecond._meta.get_field('document_ptr'))
+        self.assertIs(PickingFirst._meta.pk, PickingFirst._meta.get_field('document_ptr'))
+        self.assertIs(PickingSecond._meta.pk, PickingSecond._meta.get_field('document_ptr'))
