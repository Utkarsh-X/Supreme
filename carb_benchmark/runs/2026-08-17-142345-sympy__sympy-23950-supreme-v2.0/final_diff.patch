diff --git a/sympy/sets/contains.py b/sympy/sets/contains.py
index b2d4268..695fc9e 100644
--- a/sympy/sets/contains.py
+++ b/sympy/sets/contains.py
@@ -44,5 +44,22 @@ def binary_symbols(self):
             if i.is_Boolean or i.is_Symbol or
             isinstance(i, (Eq, Ne))])
 
-    def as_set(self):
-        raise NotImplementedError()
+    def _eval_as_set(self):
+        from sympy.sets.conditionset import ConditionSet
+        val = self.args[0]
+        s = self.args[1]
+        if val.is_Symbol and val not in s.free_symbols:
+            return s
+        try:
+            rel = s.as_relational(val)
+        except (NotImplementedError, AttributeError):
+            rel = None
+        if rel is not None and not isinstance(rel, Contains):
+            return rel.as_set()
+
+        free = self.free_symbols
+        if len(free) == 1:
+            x = list(free)[0]
+            return ConditionSet(x, self, S.UniversalSet)
+        raise NotImplementedError("multivariate as_set is not implemented for Contains")
+
