+
+    def test_radioselect_empty_label(self):
+        f = forms.ModelChoiceField(Category.objects.all(), widget=forms.RadioSelect)
+        self.assertIsNone(f.empty_label)
+        self.assertEqual(list(f.choices), [
+            (self.c1.pk, 'Entertainment'),
+            (self.c2.pk, 'A test'),
+            (self.c3.pk, 'Third'),
+        ])
+        f_optional = forms.ModelChoiceField(Category.objects.all(), widget=forms.RadioSelect, required=False)
+        self.assertEqual(f_optional.empty_label, '---------')
+        self.assertEqual(list(f_optional.choices), [
+            ('', '---------'),
+            (self.c1.pk, 'Entertainment'),
+            (self.c2.pk, 'A test'),
+            (self.c3.pk, 'Third'),
+        ])
+        f_custom = forms.ModelChoiceField(
+            Category.objects.all(), widget=forms.RadioSelect, empty_label='Custom',
+        )
+        self.assertIsNone(f_custom.empty_label)
+
+    def test_modelform_radioselect_required_foreignkey(self):
+        w1 = Writer.objects.create(name='Writer 1')
+        class ArticleForm(forms.ModelForm):
+            class Meta:
+                model = Article
+                fields = ['writer']
+                widgets = {'writer': forms.RadioSelect()}
+
+        form = ArticleForm()
+        self.assertHTMLEqual(
+            str(form['writer']),
+            '<ul id="id_writer">'
+            '<li><label for="id_writer_0"><input type="radio" name="writer" value="%d" id="id_writer_0" required> Writer 1</label></li>'
+            '</ul>' % w1.pk
+        )
