-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    s = input_data[0]
+    
+    offset = [0] * 10
+    idx = 0
+    for d in range(1, 10):
+        offset[d] = idx
+        idx += d
+
+    trans_flat = [[0] * 45 for _ in range(10)]
+    start_state = [[0] * 10 for _ in range(10)]
+
+    for c in range(10):
+        for d in range(1, 10):
+            start_state[c][d] = offset[d] + (c % d)
+            for r in range(d):
+                src = offset[d] + r
+                dst = offset[d] + ((r * 10 + c) % d)
+                trans_flat[c][src] = dst
+
+    ans_state = [offset[c] for c in range(10)]
+
+    digits = [ord(ch) - 48 for ch in s]
+    curr = [0] * 45
+    ans = 0
+
+    for c in digits:
+        nxt = [0] * 45
+        tr = trans_flat[c]
+        st = start_state[c]
+        for cnt, dst in zip(curr, tr):
+            if cnt:
+                nxt[dst] += cnt
+        for d in range(1, 10):
+            nxt[st[d]] += 1
+            
+        if c != 0:
+            ans += nxt[ans_state[c]]
+        curr = nxt
+
+    print(ans)
+
+if __name__ == '__main__':
+    main()
