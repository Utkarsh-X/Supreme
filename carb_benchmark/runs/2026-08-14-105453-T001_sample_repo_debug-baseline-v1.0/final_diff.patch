+# Actual (SymPy 1.12): -x (Correct)
+
+# Additional tests for completeness:
+# 4. simplify(Abs(x), x > 0)
+expr_abs_x_positive = simplify(Abs(x), x > 0)
+print(f"simplify(Abs(x), x > 0): {expr_abs_x_positive}")
