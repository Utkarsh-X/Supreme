+    def test_fast_delete_combined_relationships(self):
+        r = Referrer.objects.create(unique_field=1, origin=Origin.objects.create())
+        SecondReferrer.objects.create(referrer=r, other_referrer=r)
+        # 1 query for fast delete of SecondReferrer (combining referrer and other_referrer)
+        # 1 query for Referrer delete
+        with self.assertNumQueries(2) as ctx:
+            r.delete()
+        self.assertIn(' OR ', ctx.captured_queries[0]['sql'])
+        self.assertFalse(SecondReferrer.objects.exists())
+        self.assertFalse(Referrer.objects.exists())
