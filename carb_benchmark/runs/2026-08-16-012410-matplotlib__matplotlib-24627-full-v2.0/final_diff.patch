+def test_cla_clf_clears_axes_figure():
+    fig, ax = plt.subplots()
+    ln, = ax.plot([1, 2])
+    patch = ax.add_patch(plt.Rectangle((0, 0), 1, 1))
+    txt = ax.text(0.5, 0.5, 'hello')
+    leg = ax.legend(['line'])
+
+    ax.clear()
+    for art in [ln, patch, txt, leg]:
+        assert art.axes is None
+        assert art.figure is None
+
+    # Test adding line to another axes after clear
+    fig, (ax1, ax2) = plt.subplots(1, 2)
+    ln, = ax1.plot([1, 2])
+    ax1.clear()
+    ax2.add_line(ln)
+    assert ln.axes is ax2
+    assert ln.figure is fig
+
+    # Test clf
+    fig, ax = plt.subplots()
+    ln, = ax.plot([1, 2])
+    ftl = fig.text(0.1, 0.1, 'figtext')
+    fleg = fig.legend(['a'])
+    fig.clear()
+    for art in [ax, ln, ftl, fleg]:
+        assert art.axes is None
+        assert art.figure is None
+
