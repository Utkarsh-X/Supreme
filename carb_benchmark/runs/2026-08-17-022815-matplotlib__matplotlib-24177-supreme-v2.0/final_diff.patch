+def test_hist_step_autoscale_density():
+    # GH 24177
+    np.random.seed(42)
+    data = np.random.randn(10000) * 1.2
+    fig, (ax_bar, ax_step) = plt.subplots(1, 2)
+    ax_bar.hist(data, bins=50, density=True, histtype='bar')
+    ax_step.hist(data, bins=50, density=True, histtype='step')
+    fig.canvas.draw()
+    assert_allclose(ax_step.get_ylim(), ax_bar.get_ylim())
