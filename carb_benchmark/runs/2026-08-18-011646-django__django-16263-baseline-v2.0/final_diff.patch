+    def _get_referenced_annotation_aliases(self):
+        """
+        Return the set of annotation aliases that are referenced by filters,
+        ordering, grouping, distinct_fields, select, extra, or other
+        referenced annotations.
+        """
+        if not self.annotations:
+            return set()
+
+        candidate_aliases = set(self.annotations.keys())
+        candidate_aliases.discard("__count")
+
+        if not candidate_aliases:
+            return set()
+
+        referenced = set()
+
+        if self.annotation_select_mask is not None:
+            referenced.update(candidate_aliases & self.annotation_select_mask)
+
+        def collect_refs(expr):
+            stack = [expr]
+            while stack:
+                curr = stack.pop()
+                if curr is None:
+                    continue
+
+                if isinstance(curr, str):
+                    name = curr.lstrip("-").split(LOOKUP_SEP)[0]
+                    if name in candidate_aliases:
+                        referenced.add(name)
+                    continue
+
+                if isinstance(curr, Ref):
+                    if curr.refs in candidate_aliases:
+                        referenced.add(curr.refs)
+                elif isinstance(curr, F):
+                    name = curr.name.split(LOOKUP_SEP)[0]
+                    if name in candidate_aliases:
+                        referenced.add(name)
+                else:
+                    for alias in candidate_aliases:
+                        if curr is self.annotations[alias]:
+                            referenced.add(alias)
+                        else:
+                            try:
+                                if curr == self.annotations[alias]:
+                                    referenced.add(alias)
+                            except Exception:
+                                pass
+
+                if hasattr(curr, "get_source_expressions"):
+                    try:
+                        for child in curr.get_source_expressions():
+                            if child is not None:
+                                stack.append(child)
+                    except Exception:
+                        pass
+                elif hasattr(curr, "children"):
+                    for child in curr.children:
+                        if child is not None:
+                            stack.append(child)
+
+        if self.where:
+            collect_refs(self.where)
+
+        if self.order_by:
+            for item in self.order_by:
+                collect_refs(item)
+
+        if isinstance(self.group_by, (tuple, list)):
+            for item in self.group_by:
+                collect_refs(item)
+
+        if self.distinct_fields:
+            for item in self.distinct_fields:
+                collect_refs(item)
+
+        if self.select:
+            for item in self.select:
+                collect_refs(item)
+
+        if self.extra:
+            for item in self.extra.values():
+                collect_refs(item)
+        if self.extra_order_by:
+            for item in self.extra_order_by:
+                collect_refs(item)
+
+        if self.combined_queries:
+            for combined_query in self.combined_queries:
+                collect_refs(combined_query.where)
+
+        while True:
+            added = False
+            for alias in list(referenced):
+                ann = self.annotations.get(alias)
+                if ann is not None:
+                    before_len = len(referenced)
+                    collect_refs(ann)
+                    if len(referenced) > before_len:
+                        added = True
+            if not added:
+                break
+
+        return referenced
+
