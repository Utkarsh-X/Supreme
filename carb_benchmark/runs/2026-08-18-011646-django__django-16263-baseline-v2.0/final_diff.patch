+    def test_count_strip_unused_annotations(self):
+        qs = Book.objects.annotate(n_authors=Count("authors"))
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 4)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertNotIn("n_authors", sql)
+        self.assertNotIn("JOIN", sql)
+        self.assertNotIn("GROUP BY", sql)
+
+    def test_count_strip_unused_annotations_multiple(self):
+        qs = Book.objects.annotate(
+            n_authors=Count("authors"),
+            n_pages=Sum("pages"),
+        )
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 4)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertNotIn("n_authors", sql)
+        self.assertNotIn("n_pages", sql)
+        self.assertNotIn("JOIN", sql)
+        self.assertNotIn("GROUP BY", sql)
+
+    def test_count_keep_referenced_annotations_in_where(self):
+        qs = Book.objects.annotate(
+            n_authors=Count("authors"),
+            n_pages=Sum("pages"),
+        ).filter(n_authors__gt=1)
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 2)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertIn("n_authors", sql)
+        self.assertNotIn("n_pages", sql)
+
+    def test_count_keep_transitive_annotations(self):
+        qs = Book.objects.annotate(
+            n_authors=Count("authors"),
+            n_authors_plus_one=F("n_authors") + 1,
+            n_pages=Sum("pages"),
+        ).filter(n_authors_plus_one__gt=2)
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 2)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertIn("n_authors", sql)
+        self.assertNotIn("n_pages", sql)
