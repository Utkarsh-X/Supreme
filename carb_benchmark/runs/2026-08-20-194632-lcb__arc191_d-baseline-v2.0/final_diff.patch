--- a/main.py
+++ b/main.py
@@ -1 +1,175 @@
-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+from collections import deque
+
+sys.setrecursionlimit(300000)
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    N = int(input_data[0])
+    M = int(input_data[1])
+    S = int(input_data[2]) - 1
+    T = int(input_data[3]) - 1
+    
+    adj = [[] for _ in range(N)]
+    ptr = 4
+    for _ in range(M):
+        u = int(input_data[ptr]) - 1
+        v = int(input_data[ptr+1]) - 1
+        ptr += 2
+        adj[u].append(v)
+        adj[v].append(u)
+        
+    # BFS from S
+    d_S = [-1] * N
+    d_S[S] = 0
+    q = deque([S])
+    while q:
+        u = q.popleft()
+        for v in adj[u]:
+            if d_S[v] == -1:
+                d_S[v] = d_S[u] + 1
+                q.append(v)
+                
+    # BFS from T
+    d_T = [-1] * N
+    d_T[T] = 0
+    q = deque([T])
+    while q:
+        u = q.popleft()
+        for v in adj[u]:
+            if d_T[v] == -1:
+                d_T[v] = d_T[u] + 1
+                q.append(v)
+                
+    ans = float('inf')
+    d_ST = d_S[T]
+    
+    # Check degree >= 3 vertices
+    for v in range(N):
+        if len(adj[v]) >= 3:
+            if v == S or v == T:
+                ans = min(ans, 2 * d_ST + 4)
+            elif d_S[v] == d_ST + d_T[v]: # T on shortest path S->v
+                ans = min(ans, 2 * d_S[v] + 2 * d_T[v] + 4)
+            elif d_T[v] == d_ST + d_S[v]: # S on shortest path T->v
+                ans = min(ans, 2 * d_S[v] + 2 * d_T[v] + 4)
+            else:
+                ans = min(ans, 2 * d_S[v] + 2 * d_T[v] + 2)
+                
+    def process_tree(root, d_root, val_arr, is_S_root):
+        nonlocal ans
+        queue = deque([root])
+        parent = [-1] * N
+        visited = [False] * N
+        visited[root] = True
+        tree_edges = set()
+        
+        while queue:
+            u = queue.popleft()
+            for v in adj[u]:
+                if not visited[v]:
+                    visited[v] = True
+                    parent[v] = u
+                    tree_edges.add((min(u, v), max(u, v)))
+                    queue.append(v)
+                    
+        LOG = 18
+        up = [[-1] * N for _ in range(LOG)]
+        min_val = [[float('inf')] * N for _ in range(LOG)]
+        
+        for i in range(N):
+            p = parent[i]
+            up[0][i] = p
+            if p != -1:
+                min_val[0][i] = min(val_arr[i], val_arr[p])
+            else:
+                min_val[0][i] = val_arr[i]
+                
+        for k in range(1, LOG):
+            for i in range(N):
+                p = up[k-1][i]
+                if p != -1:
+                    up[k][i] = up[k-1][p]
+                    min_val[k][i] = min(min_val[k-1][i], min_val[k-1][p])
+                else:
+                    up[k][i] = -1
+                    min_val[k][i] = min_val[k-1][i]
+                    
+        def get_lca(u, v):
+            if d_root[u] < d_root[v]:
+                u, v = v, u
+            for k in range(LOG - 1, -1, -1):
+                if d_root[u] - (1 << k) >= d_root[v]:
+                    u = up[k][u]
+            if u == v:
+                return u
+            for k in range(LOG - 1, -1, -1):
+                if up[k][u] != up[k][v]:
+                    u = up[k][u]
+                    v = up[k][v]
+            return up[0][u]
+            
+        def query_strict(u, lca):
+            if u == lca:
+                return float('inf')
+            res = val_arr[u]
+            curr = u
+            for k in range(LOG - 1, -1, -1):
+                if d_root[curr] - (1 << k) > d_root[lca]:
+                    res = min(res, min_val[k][curr])
+                    curr = up[k][curr]
+            res = min(res, val_arr[curr])
+            return res
+
+        for u in range(N):
+            for v in adj[u]:
+                if u < v:
+                    if (min(u, v), max(u, v)) not in tree_edges:
+                        lca = get_lca(u, v)
+                        len_C = d_root[u] + d_root[v] - 2 * d_root[lca] + 1
+                        val_u = query_strict(u, lca)
+                        val_v = query_strict(v, lca)
+                        min_strict = min(val_u, val_v)
+                        
+                        if is_S_root:
+                            dS_lca = d_root[lca]
+                            dT_lca = val_arr[lca]
+                            if min_strict <= dT_lca:
+                                dT_min = min_strict
+                                penalty = 0
+                            else:
+                                dT_min = dT_lca
+                                penalty = 2
+                                
+                            if dS_lca == d_ST + dT_lca:
+                                penalty += 2
+                            cost = 2 * dS_lca + 2 * dT_min + len_C + penalty
+                        else:
+                            dT_lca = d_root[lca]
+                            dS_lca = val_arr[lca]
+                            if min_strict <= dS_lca:
+                                dS_min = min_strict
+                                penalty = 0
+                            else:
+                                dS_min = dS_lca
+                                penalty = 2
+                                
+                            if dT_lca == d_ST + dS_lca:
+                                penalty += 2
+                            cost = 2 * dT_lca + 2 * dS_min + len_C + penalty
+                            
+                        ans = min(ans, cost)
+
+    process_tree(S, d_S, d_T, True)
+    process_tree(T, d_T, d_S, False)
+    
+    if ans == float('inf'):
+        print(-1)
+    else:
+        print(ans)
+
+if __name__ == '__main__':
+    main()
