-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input = sys.stdin.read
+    data = input().split()
+    if not data:
+        return
+    N = int(data[0])
+    
+    grid = [['' for _ in range(N)] for _ in range(N)]
+    
+    for i in range(1, N + 1):
+        j = N + 1 - i
+        if i <= j:
+            color = '#' if i % 2 == 1 else '.'
+            for r in range(i - 1, j):
+                for c in range(i - 1, j):
+                    grid[r][c] = color
+                    
+    for row in grid:
+        print("".join(row))
+
+if __name__ == '__main__':
+    main()
