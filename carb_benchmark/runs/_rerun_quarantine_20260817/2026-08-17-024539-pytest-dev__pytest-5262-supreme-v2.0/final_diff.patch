+def test_encodedfile_mode():
+    class DummyBuffer(object):
+        def __init__(self, mode):
+            self.mode = mode
+
+    ef = capture.EncodedFile(DummyBuffer("rb+"), "utf-8")
+    assert ef.mode == "r+"
+    assert "b" not in ef.mode
+
+    ef = capture.EncodedFile(DummyBuffer("wb+"), "utf-8")
+    assert ef.mode == "w+"
+
+    ef = capture.EncodedFile(DummyBuffer("wb"), "utf-8")
+    assert ef.mode == "w"
+
+    ef = capture.EncodedFile(DummyBuffer(None), "utf-8")
+    assert ef.mode is None
+
+    ef = capture.EncodedFile(object(), "utf-8")
+    with pytest.raises(AttributeError):
+        ef.mode
+
+
+@needsosdup
+def test_safe_text_dupfile_mode(tmpfile):
+    nf = capture.safe_text_dupfile(tmpfile, "wb")
+    assert "b" not in nf.mode
