@@ -217,6 +217,19 @@ def test_unpickle_canvas():
     assert fig2.canvas is not None
 
 
+def test_unpickle_dpi():
+    fig = plt.figure()
+    fig.canvas._set_device_pixel_ratio(2)
+    dpi = fig.dpi
+    out = BytesIO()
+    pickle.dump(fig, out)
+    out.seek(0)
+    fig2 = pickle.load(out)
+    assert fig2.dpi == dpi
+    fig2.canvas._set_device_pixel_ratio(2)
+    assert fig2.dpi == dpi
+
+
