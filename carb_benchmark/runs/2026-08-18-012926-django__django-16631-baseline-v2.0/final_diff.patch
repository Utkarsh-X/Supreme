+class AbstractBaseUserTests(TestCase):
+    def test_get_session_auth_hash(self):
+        user = User(password="secret_pass")
+        hash_default = user.get_session_auth_hash()
+        hash_custom = user.get_session_auth_hash(secret="custom-secret")
+        self.assertNotEqual(hash_default, hash_custom)
+
+    @override_settings(SECRET_KEY_FALLBACKS=["fallback-key-1", "fallback-key-2"])
+    def test_get_session_auth_fallback_hashes(self):
+        user = User(password="secret_pass")
+        fallback_hashes = list(user.get_session_auth_fallback_hashes())
+        self.assertEqual(
+            fallback_hashes,
+            [
+                user.get_session_auth_hash(secret="fallback-key-1"),
+                user.get_session_auth_hash(secret="fallback-key-2"),
+            ],
+        )
+
+    @override_settings(SECRET_KEY_FALLBACKS=["fallback-key-1"])
+    def test_get_session_auth_fallback_hashes_custom_user_no_secret_arg(self):
+        class NoSecretArgUser:
+            def get_session_auth_hash(self):
+                return "custom_hash"
+
+            get_session_auth_fallback_hashes = (
+                AbstractBaseUser.get_session_auth_fallback_hashes
+            )
+
+        user = NoSecretArgUser()
+        fallback_hashes = list(user.get_session_auth_fallback_hashes())
+        self.assertEqual(fallback_hashes, ["custom_hash"])
