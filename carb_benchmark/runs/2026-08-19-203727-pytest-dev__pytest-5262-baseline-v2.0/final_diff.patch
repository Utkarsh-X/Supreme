+def test_encodedfile_mode():
+    class Buffer(object):
+        def __init__(self, mode):
+            self.mode = mode
+
+    for mode, expected in [
+        ("rb+", "r+"),
+        ("wb+", "w+"),
+        ("r+b", "r+"),
+        ("w+b", "w+"),
+        ("rb", "r"),
+        ("wb", "w"),
+    ]:
+        ef = capture.EncodedFile(Buffer(mode), "utf-8")
+        assert ef.mode == expected
+        assert "b" not in ef.mode
+
+    ef_none = capture.EncodedFile(None, "utf-8")
+    assert ef_none.mode is None
+
+
+def test_safe_text_dupfile_mode(tmpdir):
+    f = open(str(tmpdir.join("test")), "wb+")
+    dup = capture.safe_text_dupfile(f, mode="wb+")
+    assert "b" not in dup.mode
+    dup.close()
+    f.close()
+
