diff --git a/sympy/sets/contains.py b/sympy/sets/contains.py
index b2d4268..56aaaeb 100644
--- a/sympy/sets/contains.py
+++ b/sympy/sets/contains.py
@@ -45,4 +45,47 @@ def binary_symbols(self):
             isinstance(i, (Eq, Ne))])
 
     def as_set(self):
-        raise NotImplementedError()
+        """
+        Rewrites Contains expression in terms of a set.
+
+        Examples
+        ========
+
+        >>> from sympy import Symbol, S, Contains, Interval
+        >>> x = Symbol('x')
+        >>> Contains(x, S.Reals).as_set()
+        Reals
+        >>> Contains(x, Interval(0, 1)).as_set()
+        Interval(0, 1)
+        """
+        from sympy.sets.conditionset import ConditionSet
+        from sympy.core.symbol import Symbol
+        from sympy.core.containers import Tuple
+        from sympy.utilities.iterables import default_sort_key
+
+        expr, s = self.args
+        if isinstance(expr, Symbol):
+            return s
+
+        if isinstance(expr, Tuple) and all(isinstance(i, Symbol) for i in expr) and len(set(expr)) == len(expr):
+            return s
+
+        try:
+            r = expr.args if isinstance(expr, Tuple) else (expr,)
+            return s.as_relational(*r).as_set()
+        except (NotImplementedError, AttributeError, ValueError, TypeError):
+            pass
+
+        free = expr.free_symbols
+        if len(free) == 1:
+            x = next(iter(free))
+            return ConditionSet(x, self)
+        elif len(free) > 1:
+            syms = Tuple(*sorted(free, key=default_sort_key))
+            return ConditionSet(syms, self)
+
+        raise NotImplementedError(f"as_set is not implemented for {self}")
+
+    def _eval_as_set(self):
+        return self.as_set()
+
