-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    P = [int(x) for x in input_data[1:N+1]]
+    
+    max_step = 1 << (N.bit_length() - 1)
+    size = max_step << 1
+    tree = [N + 1] * (size + 1)
+    
+    for i in range(1, N + 1):
+        tree[i] = 1
+    for i in range(1, size + 1):
+        nxt = i + (i & (-i))
+        if nxt <= size:
+            tree[nxt] += tree[i]
+
+    ans = [0] * (N + 1)
+    
+    for i in range(N, 0, -1):
+        k = P[i - 1]
+        idx = 0
+        current_sum = 0
+        step = max_step
+        while step:
+            nxt = idx + step
+            val = current_sum + tree[nxt]
+            if val < k:
+                idx = nxt
+                current_sum = val
+            step >>= 1
+        pos = idx + 1
+        ans[pos] = i
+        
+        p = pos
+        while p <= N:
+            tree[p] -= 1
+            p += p & (-p)
+
+    sys.stdout.write(" ".join(map(str, ans[1:])) + "\n")
+
+if __name__ == '__main__':
+    main()
