-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import math
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    
+    ans = 0
+    E = 1
+    while (1 << E) <= N:
+        M = N >> E
+        c_max = math.isqrt(M)
+        ans += (c_max + 1) // 2
+        E += 1
+        
+    print(ans)
+
+if __name__ == '__main__':
+    solve()
