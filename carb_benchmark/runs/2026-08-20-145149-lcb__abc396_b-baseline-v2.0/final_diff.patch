-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input = sys.stdin.read
+    data = input().split()
+    if not data:
+        return
+    
+    Q = int(data[0])
+    idx = 1
+    
+    stack = [0] * 100
+    out = []
+    
+    for _ in range(Q):
+        t = data[idx]
+        idx += 1
+        if t == '1':
+            x = int(data[idx])
+            idx += 1
+            stack.append(x)
+        else:
+            out.append(str(stack.pop()))
+            
+    print('\n'.join(out))
+
+if __name__ == '__main__':
+    main()
