-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    iterator = iter(input_data)
+    N = int(next(iterator))
+    
+    W = [0] + [int(next(iterator)) for _ in range(N)]
+    
+    intervals = [None] * (N + 1)
+    max_coord = 2 * N + 5
+    
+    for i in range(1, N + 1):
+        l = int(next(iterator))
+        r = int(next(iterator))
+        intervals[i] = (l, r)
+        if r > max_coord:
+            max_coord = r
+            
+    max_coord += 5
+    INF = 10**18
+    
+    pref_min_R = [INF] * (max_coord + 1)
+    suff_min_L = [INF] * (max_coord + 1)
+    
+    for i in range(1, N + 1):
+        l, r = intervals[i]
+        w = W[i]
+        if w < pref_min_R[r]:
+            pref_min_R[r] = w
+        if w < suff_min_L[l]:
+            suff_min_L[l] = w
+            
+    for i in range(1, max_coord + 1):
+        if pref_min_R[i - 1] < pref_min_R[i]:
+            pref_min_R[i] = pref_min_R[i - 1]
+            
+    for i in range(max_coord - 1, -1, -1):
+        if suff_min_L[i + 1] < suff_min_L[i]:
+            suff_min_L[i] = suff_min_L[i + 1]
+            
+    Q = int(next(iterator))
+    out = []
+    
+    for _ in range(Q):
+        s = int(next(iterator))
+        t = int(next(iterator))
+        
+        Ls, Rs = intervals[s]
+        Lt, Rt = intervals[t]
+        Ws = W[s]
+        Wt = W[t]
+        
+        best = INF
+        
+        # 1-hop (direct edge)
+        if Rs < Lt or Rt < Ls:
+            best = Ws + Wt
+        else:
+            # 2-hop
+            mL = Ls if Ls < Lt else Lt
+            mR = Rs if Rs > Rt else Rt
+            
+            min_left = pref_min_R[mL - 1] if mL - 1 >= 0 else INF
+            min_right = suff_min_L[mR + 1] if mR + 1 <= max_coord else INF
+            
+            c2 = min_left if min_left < min_right else min_right
+            if c2 != INF:
+                cand = Ws + Wt + c2
+                if cand < best:
+                    best = cand
+                    
+            # 3-hop Struct A: R_u < L_s and L_v > R_t
+            uA = pref_min_R[Ls - 1] if Ls - 1 >= 0 else INF
+            vA = suff_min_L[Rt + 1] if Rt + 1 <= max_coord else INF
+            if uA != INF and vA != INF:
+                cand = Ws + Wt + uA + vA
+                if cand < best:
+                    best = cand
+                    
+            # 3-hop Struct B: L_u > R_s and R_v < L_t
+            uB = suff_min_L[Rs + 1] if Rs + 1 <= max_coord else INF
+            vB = pref_min_R[Lt - 1] if Lt - 1 >= 0 else INF
+            if uB != INF and vB != INF:
+                cand = Ws + Wt + uB + vB
+                if cand < best:
+                    best = cand
+                    
+        out.append(str(best) if best != INF else "-1")
+        
+    sys.stdout.write("\n".join(out) + "\n")
+
+if __name__ == '__main__':
+    main()
