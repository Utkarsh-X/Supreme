-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import math
+
+def icbrt_less(n):
+    if n <= 1:
+        return 0
+    r = int(n ** (1/3))
+    while (r + 1) ** 3 < n:
+        r += 1
+    while r ** 3 >= n:
+        r -= 1
+    return r
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    
+    limit = icbrt_less(N)
+    for d in range(1, limit + 1):
+        if N % d != 0:
+            continue
+        K = N // d
+        rem = 4 * K - d * d
+        if rem <= 0 or rem % 3 != 0:
+            continue
+        val = rem // 3
+        s = math.isqrt(val)
+        if s * s == val and s > d and (s - d) % 2 == 0:
+            y = (s - d) // 2
+            x = y + d
+            print(f"{x} {y}")
+            return
+            
+    print("-1")
+
+if __name__ == '__main__':
+    solve()
