-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    A = [int(x) for x in input_data[1:]]
+    
+    dp = [0] * (N + 1)
+    max_even = 0  # dp[0]
+    max_odd = -float('inf')
+    
+    for i in range(1, N + 1):
+        res = dp[i - 1] + A[i - 1]
+        
+        if i % 2 == 0:
+            if max_even != -float('inf'):
+                res = max(res, max_even)
+            dp[i] = res
+            max_even = max(max_even, dp[i])
+        else:
+            if max_odd != -float('inf'):
+                res = max(res, max_odd)
+            dp[i] = res
+            max_odd = max(max_odd, dp[i])
+            
+    print(dp[N])
+
+if __name__ == '__main__':
+    main()
