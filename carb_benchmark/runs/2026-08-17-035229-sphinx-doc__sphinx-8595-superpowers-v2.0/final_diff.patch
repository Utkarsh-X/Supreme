diff --git a/tests/test_ext_autodoc.py b/tests/test_ext_autodoc.py
index 39897eb..c04964b 100644
--- a/tests/test_ext_autodoc.py
+++ b/tests/test_ext_autodoc.py
@@ -738,6 +738,41 @@ def test_autodoc_ignore_module_all(app):
     ]
 
 
+@pytest.mark.sphinx('html', testroot='ext-autodoc')
+def test_autodoc_empty_all(app):
+    # default (empty __all__ is respected)
+    options = {"members": None}
+    actual = do_autodoc(app, 'module', 'target.empty_all', options)
+    assert list(actual) == [
+        '',
+        '.. py:module:: target.empty_all',
+        '',
+    ]
+
+    # ignore-module-all (empty __all__ is ignored)
+    options = {"members": None,
+               "ignore-module-all": None}
+    actual = do_autodoc(app, 'module', 'target.empty_all', options)
+    assert list(actual) == [
+        '',
+        '.. py:module:: target.empty_all',
+        '',
+        '',
+        '.. py:function:: bar()',
+        '   :module: target.empty_all',
+        '',
+        '   bar docstring',
+        '',
+        '',
+        '.. py:function:: foo()',
+        '   :module: target.empty_all',
+        '',
+        '   foo docstring',
+        '',
+    ]
+
+
+
