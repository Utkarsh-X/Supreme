+
+
+def test_unpickle_with_device_pixel_ratio():
+    import pickle
+    fig = plt.figure()
+    fig.canvas._set_device_pixel_ratio(2)
+    target_dpi = fig.dpi
+    assert target_dpi == 2 * fig._original_dpi
+
+    for _ in range(3):
+        fig = pickle.loads(pickle.dumps(fig))
+        fig.canvas._set_device_pixel_ratio(2)
+        assert fig.dpi == target_dpi
+
