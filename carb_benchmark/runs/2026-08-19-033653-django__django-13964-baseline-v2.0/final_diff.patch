+    def test_save_fk_after_parent_with_non_auto_pk(self):
+        parent = PrimaryKeyWithNonAuto()
+        child = ChildWithNonAutoPKParent(parent=parent)
+        parent.key = 'foo'
+        parent.save()
+        child.save()
+        self.assertEqual(child.parent_id, 'foo')
+        self.assertEqual(child.parent, parent)
+        self.assertTrue(ChildWithNonAutoPKParent.objects.filter(parent=parent).exists())
+
+    def test_save_fk_after_parent_with_to_field_empty(self):
