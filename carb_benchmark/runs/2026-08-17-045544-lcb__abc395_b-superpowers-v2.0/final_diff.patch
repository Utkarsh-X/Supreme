-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    
+    grid = []
+    for r in range(1, N + 1):
+        row = []
+        for c in range(1, N + 1):
+            d = min(r, c, N + 1 - r, N + 1 - c)
+            if d % 2 == 1:
+                row.append('#')
+            else:
+                row.append('.')
+        grid.append("".join(row))
+        
+    print("\n".join(grid))
+
+if __name__ == '__main__':
+    solve()
