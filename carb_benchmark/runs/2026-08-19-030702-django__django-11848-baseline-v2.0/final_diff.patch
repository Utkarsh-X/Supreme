+    def test_parsing_rfc850_two_digit_year(self):
+        class MockDatetime(datetime):
+            @classmethod
+            def utcnow(cls):
+                return cls._utcnow
+
+        tests = (
+            (2019, 'Sunday, 06-Nov-69 08:49:37 GMT', datetime(2069, 11, 6, 8, 49, 37)),
+            (2019, 'Sunday, 06-Nov-70 08:49:37 GMT', datetime(1970, 11, 6, 8, 49, 37)),
+            (2070, 'Sunday, 06-Nov-20 08:49:37 GMT', datetime(2120, 11, 6, 8, 49, 37)),
+            (2070, 'Sunday, 06-Nov-21 08:49:37 GMT', datetime(2021, 11, 6, 8, 49, 37)),
+            (2000, 'Sunday, 06-Nov-50 08:49:37 GMT', datetime(2050, 11, 6, 8, 49, 37)),
+            (2000, 'Sunday, 06-Nov-51 08:49:37 GMT', datetime(1951, 11, 6, 8, 49, 37)),
+            (2099, 'Sunday, 06-Nov-49 08:49:37 GMT', datetime(2149, 11, 6, 8, 49, 37)),
+            (2099, 'Sunday, 06-Nov-50 08:49:37 GMT', datetime(2050, 11, 6, 8, 49, 37)),
+        )
+        for current_year, date_str, expected in tests:
+            with self.subTest(date_str, current_year=current_year):
+                with mock.patch('django.utils.http.datetime.datetime', MockDatetime):
+                    MockDatetime._utcnow = datetime(current_year, 1, 1)
+                    parsed = parse_http_date(date_str)
+                    dt = datetime.utcfromtimestamp(parsed) if parsed >= 0 else datetime(1970, 1, 1) + timedelta(seconds=parsed)
+                    self.assertEqual(dt, expected)
