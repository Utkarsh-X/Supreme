+
+def test_unpickle_dpi_device_pixel_ratio():
+    fig = plt.figure(dpi=100)
+    fig.canvas._set_device_pixel_ratio(2)
+    assert fig.dpi == 200
+
+    for _ in range(3):
+        buf = pickle.dumps(fig)
+        fig = pickle.loads(buf)
+        assert fig.dpi == 100
+        fig.canvas._set_device_pixel_ratio(2)
+        assert fig.dpi == 200
