+def test_hist_step_autoscale():
+    # Test that step histogram path simplification does not affect autoscale limits
+    np.random.seed(42)
+    data = np.random.randn(100000) * 1.2
+    fig, (ax0, ax1) = plt.subplots(1, 2)
+    ax0.hist(data, bins=100, density=True, histtype='bar')
+    ax1.hist(data, bins=100, density=True, histtype='step')
+    np.testing.assert_allclose(ax0.get_ylim(), ax1.get_ylim())
+
