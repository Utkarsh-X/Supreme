-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    
+    Q = int(input_data[0])
+    idx = 1
+    
+    stack = [0] * 100
+    
+    out = []
+    for _ in range(Q):
+        t = int(input_data[idx])
+        idx += 1
+        if t == 1:
+            x = int(input_data[idx])
+            idx += 1
+            stack.append(x)
+        else:
+            top_val = stack.pop()
+            out.append(str(top_val))
+            
+    print('\n'.join(out))
+
+if __name__ == '__main__':
+    main()
