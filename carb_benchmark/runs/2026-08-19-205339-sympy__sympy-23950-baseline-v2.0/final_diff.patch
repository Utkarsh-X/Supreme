-    def as_set(self):
-        raise NotImplementedError()
+    def _eval_as_set(self):
+        from sympy.core.symbol import Symbol
+        expr, s = self.args
+        if isinstance(expr, Symbol) and expr not in s.free_symbols:
+            return s
+        return s.as_relational(expr).as_set()
