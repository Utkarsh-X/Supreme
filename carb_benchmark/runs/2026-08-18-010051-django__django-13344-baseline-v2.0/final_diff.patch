diff --git a/tests/deprecation/test_middleware_mixin.py b/tests/deprecation/test_middleware_mixin.py
index c90aeb8..65bbfa7 100644
--- a/tests/deprecation/test_middleware_mixin.py
+++ b/tests/deprecation/test_middleware_mixin.py
@@ -78,3 +78,22 @@ class MiddlewareMixinTests(SimpleTestCase):
 
         self.assertEqual(len(threads_and_connections), 4)
         self.assertEqual(len(set(threads_and_connections)), 1)
+
+    async def test_middleware_mixin_async_chain(self):
+        async def get_response(request):
+            return HttpResponse()
+
+        class CustomInitMiddleware(MiddlewareMixin):
+            def __init__(self, get_response=None):
+                self.get_response = get_response
+
+        class FirstMiddleware(MiddlewareMixin):
+            def process_response(self, request, response):
+                self.response_type = type(response)
+                return response
+
+        first_mw = FirstMiddleware(CustomInitMiddleware(get_response))
+        response = await first_mw(HttpRequest())
+        self.assertIsInstance(response, HttpResponse)
+        self.assertIs(first_mw.response_type, HttpResponse)
+
