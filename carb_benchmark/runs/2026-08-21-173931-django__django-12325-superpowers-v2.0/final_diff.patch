+    @isolate_apps('model_inheritance')
+    def test_multiple_onetoone_parent_link_order(self):
+        class Document(models.Model):
+            pass
+
+        class Picking1(Document):
+            document_ptr = models.OneToOneField(Document, on_delete=models.CASCADE, parent_link=True, related_name='+')
+            origin = models.OneToOneField(Document, related_name='picking1_origin', on_delete=models.PROTECT)
+
+        class Picking2(Document):
+            origin = models.OneToOneField(Document, related_name='picking2_origin', on_delete=models.PROTECT)
+            document_ptr = models.OneToOneField(Document, on_delete=models.CASCADE, parent_link=True, related_name='+')
+
+        self.assertIs(Picking1._meta.parents[Document], Picking1._meta.get_field('document_ptr'))
+        self.assertEqual(Picking1._meta.pk.name, 'document_ptr')
+        self.assertIs(Picking2._meta.parents[Document], Picking2._meta.get_field('document_ptr'))
+        self.assertEqual(Picking2._meta.pk.name, 'document_ptr')
+
