-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+from collections import Counter
+from itertools import combinations
+
+def solve():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    A = list(map(int, input_data))
+    
+    for combo in combinations(A, 5):
+        counts = sorted(Counter(combo).values())
+        if counts == [2, 3]:
+            print("Yes")
+            return
+    print("No")
+
+if __name__ == "__main__":
+    solve()
