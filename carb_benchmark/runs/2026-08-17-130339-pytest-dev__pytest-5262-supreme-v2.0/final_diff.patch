@@ -952,6 +952,26 @@ def test_dupfile_on_textio():
     assert not hasattr(f, "name")
 
 
+def test_encodedfile_mode(tmpfile):
+    f = capture.safe_text_dupfile(tmpfile, "wb")
+    try:
+        assert "b" not in f.mode
+    finally:
+        f.close()
+
+    class DummyBuffer(object):
+        mode = "rb+"
+
+    ef = capture.EncodedFile(DummyBuffer(), "utf-8")
+    assert ef.mode == "r+"
+
+    DummyBuffer.mode = "r+b"
+    assert ef.mode == "r+"
+
+    DummyBuffer.mode = "wb"
+    assert ef.mode == "w"
+
