-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    A = [int(x) for x in input_data[1:N + 1]]
+    
+    ans = 0
+    j = 0
+    for i in range(N):
+        target = 2 * A[i]
+        while j < N and A[j] < target:
+            j += 1
+        ans += (N - j)
+        
+    print(ans)
+
+if __name__ == '__main__':
+    main()
