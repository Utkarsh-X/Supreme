+def test_unpickle_dpi_device_pixel_ratio():
+    fig = plt.figure()
+    fig.canvas._set_device_pixel_ratio(2)
+    target_dpi = fig.dpi
+    for _ in range(3):
+        fig = pickle.loads(pickle.dumps(fig))
+        fig.canvas._set_device_pixel_ratio(2)
+        assert fig.dpi == target_dpi
