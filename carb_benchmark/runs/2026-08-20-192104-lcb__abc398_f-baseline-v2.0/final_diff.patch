-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    S = input_data[0]
+    
+    R = S[::-1]
+    T = R + "#" + S
+    n = len(T)
+    pi = [0] * n
+    for i in range(1, n):
+        j = pi[i - 1]
+        while j > 0 and T[i] != T[j]:
+            j = pi[j - 1]
+        if T[i] == T[j]:
+            j += 1
+        pi[i] = j
+    
+    k = pi[-1]
+    ans = S + S[: len(S) - k][::-1]
+    print(ans)
+
+if __name__ == "__main__":
+    main()
