-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    P = [int(x) for x in input_data[1:N+1]]
+    
+    for p in P:
+        rank = 1 + sum(1 for x in P if x > p)
+        print(rank)
+
+if __name__ == '__main__':
+    main()
