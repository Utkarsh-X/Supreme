diff --git a/tests/forms_tests/field_tests/test_multivaluefield.py b/tests/forms_tests/field_tests/test_multivaluefield.py
index 29287d0..9de92ae 100644
--- a/tests/forms_tests/field_tests/test_multivaluefield.py
+++ b/tests/forms_tests/field_tests/test_multivaluefield.py
@@ -172,3 +172,28 @@ class MultiValueFieldTest(SimpleTestCase):
         })
         form.is_valid()
         self.assertEqual(form.cleaned_data['field1'], 'some text,JP,2007-04-25 06:24:00')
+
+    def test_clean_require_all_fields_false(self):
+        class MF(MultiValueField):
+            def compress(self, data_list):
+                return data_list
+
+        class SubfieldForm(Form):
+            mf = MF(
+                fields=(
+                    CharField(required=False),
+                    CharField(required=True),
+                ),
+                require_all_fields=False,
+                required=False,
+                widget=MultiWidget(widgets=[TextInput, TextInput]),
+            )
+
+        form = SubfieldForm({'mf_0': '', 'mf_1': ''})
+        self.assertIs(form.is_valid(), False)
+        form = SubfieldForm({'mf_0': 'xxx', 'mf_1': ''})
+        self.assertIs(form.is_valid(), False)
+        form = SubfieldForm({'mf_0': '', 'mf_1': 'yyy'})
+        self.assertIs(form.is_valid(), True)
+        self.assertEqual(form.cleaned_data['mf'], ['', 'yyy'])
+
