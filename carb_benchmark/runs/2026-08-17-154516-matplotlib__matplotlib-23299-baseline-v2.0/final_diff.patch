diff --git a/lib/matplotlib/tests/test_rcparams.py b/lib/matplotlib/tests/test_rcparams.py
index 99856b3..f866409 100644
--- a/lib/matplotlib/tests/test_rcparams.py
+++ b/lib/matplotlib/tests/test_rcparams.py
@@ -584,3 +584,18 @@ def test_deprecation(monkeypatch):
     # Note that the warning suppression actually arises from the
     # iteration over the updater rcParams being protected by
     # suppress_matplotlib_deprecation_warning, rather than any explicit check.
+
+
+def test_rc_context_backend_auto_resolution():
+    import matplotlib.pyplot as plt
+
+    # Ensure backend is sentinel before starting test in fresh context
+    with mpl.rc_context():
+        dict.__setitem__(mpl.rcParams, "backend", mpl.rcsetup._auto_backend_sentinel)
+        with mpl.rc_context():
+            fig = plt.figure()
+        assert len(plt._pylab_helpers.Gcf.figs) == 1
+        mpl.get_backend()
+        assert len(plt._pylab_helpers.Gcf.figs) == 1
+        plt.close(fig)
+
