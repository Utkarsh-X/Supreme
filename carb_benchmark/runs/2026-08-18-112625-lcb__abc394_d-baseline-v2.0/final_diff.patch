-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def solve():
+    s = sys.stdin.read().strip()
+    stack = []
+    match = {')': '(', ']': '[', '>': '<'}
+    
+    for ch in s:
+        if ch in match:
+            if stack and stack[-1] == match[ch]:
+                stack.pop()
+            else:
+                print("No")
+                return
+        else:
+            stack.append(ch)
+            
+    if not stack:
+        print("Yes")
+    else:
+        print("No")
+
+if __name__ == '__main__':
+    solve()
