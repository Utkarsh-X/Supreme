@@ -21,6 +21,7 @@ from django.test import (
 from .models import (
     BigAutoFieldModel,
     Country,
+    CustomDbColumn,
     NoFields,
     NullableFields,
     Pizzeria,
@@ -640,6 +641,25 @@ class BulkCreateTests(TestCase):
     def test_update_conflicts_two_fields_no_unique_fields(self):
         self._test_update_conflicts_two_fields([])
 
+    @skipUnlessDBFeature("supports_update_conflicts")
+    def test_update_conflicts_db_column(self):
+        CustomDbColumn.objects.bulk_create(
+            [CustomDbColumn(custom_field=1, custom_field_other=1)]
+        )
+        unique_fields = ["custom_field"]
+        if not connection.features.supports_update_conflicts_with_target:
+            unique_fields = None
+        CustomDbColumn.objects.bulk_create(
+            [CustomDbColumn(custom_field=1, custom_field_other=2)],
+            update_conflicts=True,
+            unique_fields=unique_fields,
+            update_fields=["custom_field_other"],
+        )
+        self.assertEqual(
+            CustomDbColumn.objects.get().custom_field_other,
+            2,
+        )
+
     def _test_update_conflicts_unique_two_fields(self, unique_fields):
         Country.objects.bulk_create(self.data)
         self.assertEqual(Country.objects.count(), 4)
