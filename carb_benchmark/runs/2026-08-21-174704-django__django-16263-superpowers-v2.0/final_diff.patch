+    def test_count_unused_annotations_stripped(self):
+        qs = Book.objects.annotate(count_authors=Count("authors"))
+        with self.assertNumQueries(1) as ctx:
+            count = qs.count()
+        self.assertEqual(count, 6)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertNotIn("count_authors", sql)
+        self.assertNotIn("JOIN", sql)
+
+    def test_count_used_annotations_kept(self):
+        qs = Book.objects.annotate(count_authors=Count("authors")).filter(
+            count_authors__gt=1
+        )
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 3)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertIn("count_authors", sql)
+
+    def test_count_referenced_annotations_chain(self):
+        qs = Book.objects.annotate(
+            count_authors=Count("authors"),
+            double_authors=F("count_authors") * 2,
+            unused=Count("pages"),
+        ).filter(double_authors__gt=5)
+        with self.assertNumQueries(1) as ctx:
+            self.assertEqual(qs.count(), 1)
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertIn("count_authors", sql)
+        self.assertIn("double_authors", sql)
+        self.assertNotIn("unused", sql)
+
