-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+import json
+import re
+
+def parse_input():
+    text = sys.stdin.read().strip()
+    if not text:
+        return [], 0
+
+    nums_match = re.search(r'\[(.*?)\]', text, re.DOTALL)
+    k_match = re.search(r'k\s*=\s*(-?\d+)', text)
+    if nums_match and k_match:
+        nums_str = nums_match.group(1).strip()
+        nums = [int(x) for x in re.findall(r'-?\d+', nums_str)] if nums_str else []
+        k = int(k_match.group(1))
+        return nums, k
+
+    lines = [line.strip() for line in text.splitlines() if line.strip()]
+    if len(lines) >= 2:
+        nums_part = lines[0]
+        k_part = lines[1]
+        
+        if '[' in nums_part:
+            nums_str = nums_part[nums_part.find('['):nums_part.rfind(']')+1]
+            try:
+                nums = json.loads(nums_str)
+            except Exception:
+                nums = [int(x) for x in re.findall(r'-?\d+', nums_str)]
+        else:
+            nums = [int(x) for x in re.findall(r'-?\d+', nums_part)]
+            
+        k = int(re.search(r'-?\d+', k_part).group(0))
+        return nums, k
+    elif len(lines) == 1:
+        nums_match = re.search(r'\[(.*?)\]', text)
+        if nums_match:
+            nums_str = nums_match.group(1)
+            nums = [int(x) for x in re.findall(r'-?\d+', nums_str)] if nums_str.strip() else []
+            rest = text[nums_match.end():]
+            k_match = re.search(r'-?\d+', rest)
+            k = int(k_match.group(0)) if k_match else 0
+            return nums, k
+
+    all_nums = [int(x) for x in re.findall(r'-?\d+', text)]
+    if len(all_nums) >= 2:
+        return all_nums[:-1], all_nums[-1]
+    return [], 0
+
+def T(m):
+    if m < 0:
+        return 0
+    return (m + 1) * (m + 2) // 2
+
+def count_pairs(X, Y, K):
+    if K < 0 or X < 0 or Y < 0:
+        return 0
+    return T(K) - T(K - X - 1) - T(K - Y - 1) + T(K - X - Y - 2)
+
+def calc_max_sum(nums, k):
+    n = len(nums)
+    if n == 0 or k <= 0:
+        return 0
+    
+    K = k - 1
+
+    L = [-1] * n
+    stack = []
+    for i in range(n):
+        while stack and nums[stack[-1]] <= nums[i]:
+            stack.pop()
+        if stack:
+            L[i] = stack[-1]
+        stack.append(i)
+
+    R = [n] * n
+    stack = []
+    for i in range(n - 1, -1, -1):
+        while stack and nums[stack[-1]] < nums[i]:
+            stack.pop()
+        if stack:
+            R[i] = stack[-1]
+        stack.append(i)
+
+    total = 0
+    for i in range(n):
+        X = i - L[i] - 1
+        Y = R[i] - i - 1
+        c = count_pairs(X, Y, K)
+        total += c * nums[i]
+
+    return total
+
+def main():
+    nums, k = parse_input()
+    max_sum = calc_max_sum(nums, k)
+    min_sum = -calc_max_sum([-x for x in nums], k)
+    ans = max_sum + min_sum
+    print(ans)
+
+if __name__ == '__main__':
+    main()
