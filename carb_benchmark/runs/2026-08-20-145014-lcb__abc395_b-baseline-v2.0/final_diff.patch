-# Write your solution here. Read from stdin, print the answer to stdout.
+import sys
+
+def main():
+    input_data = sys.stdin.read().split()
+    if not input_data:
+        return
+    N = int(input_data[0])
+    
+    grid = [[''] * N for _ in range(N)]
+    
+    for i in range(1, N + 1):
+        j = N + 1 - i
+        if i <= j:
+            color = '#' if i % 2 == 1 else '.'
+            for r in range(i - 1, j):
+                for c in range(i - 1, j):
+                    grid[r][c] = color
+        else:
+            break
+            
+    for row in grid:
+        print("".join(row))
+
+if __name__ == '__main__':
+    main()
