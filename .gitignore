# ---------------------------------------------------------------------------
# CARB benchmark repository — .gitignore
#
# The repo tracks: harness code, task registry, evaluation specs/golden
# patches, per-session verdicts and diffs, and the final results.
# Everything below is either regenerable, machine-local, huge, or secret.
#
# NOTE: git does NOT strip trailing comments from ignore lines — every
# comment below lives on its own line.
# ---------------------------------------------------------------------------

# Freebuff / IDE / app state
.freebuff/
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Benchmark runtime artifacts (large, regenerable, machine-local)
# 62 task checkout repos + venvs — never commit
carb_workspaces/
# per-framework python virtualenvs (~0.5 GB)
carb_benchmark/venvs/
# agy CLI binary (~300 MB), auth profiles, keyring
carb_benchmark/tooling/
# raw public datasets (SWE-bench / LiveCodeBench corpora)
carb_benchmark/sources/data/

# Binaries / bulk data
*.bin

# Logs and scratch files
*.log
carb_benchmark/results/*_tmp.txt
carb_benchmark/results/_inspect_tmp.txt

# Secrets (defense in depth — already excluded via tooling/)
*keyring*
*_auth_profile*

# scratch files rewritten by apply_patch() on every eval/validation run
carb_benchmark/validation/*.lf.patch
